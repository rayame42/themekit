<header class="header-luxo">

  <div class="header-wrap">

    <!-- LOGO -->
    <div class="logo">
      <a href="/">{{ section.settings.logo_text }}</a>
    </div>

    <!-- MENU -->
    <nav class="menu">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="icons">
  <a href="/search" aria-label="Buscar">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <circle cx="11" cy="11" r="7" stroke="#111" stroke-width="1.5"/>
      <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="#111" stroke-width="1.5"/>
    </svg>
  </a>

  <a href="/account" aria-label="Conta">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="8" r="4" stroke="#111" stroke-width="1.5"/>
      <path d="M4 20c2-4 14-4 16 0" stroke="#111" stroke-width="1.5"/>
    </svg>
  </a>

  <a href="/cart" aria-label="Carrinho">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <circle cx="9" cy="20" r="1.5" stroke="#111" stroke-width="1.5"/>
      <circle cx="17" cy="20" r="1.5" stroke="#111" stroke-width="1.5"/>
      <path d="M3 4h2l2.5 10h11l2-7H6" stroke="#111" stroke-width="1.5"/>
    </svg>
  </a>
</div>

  </div>

</header>

<style>
.header-luxo{
  position:sticky;
  top:0;
  z-index:999;
  background:#fff;
  border-bottom:1px solid #eee;
}

.header-wrap{
  max-width:1200px;
  margin:auto;
  padding:15px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo a{
  font-size:18px;
  letter-spacing:2px;
  text-decoration:none;
  color:#111;
}

.menu{
  display:flex;
  gap:25px;
}

.menu a{
  text-decoration:none;
  font-size:12px;
  color:#111;
  letter-spacing:1px;
}

.icons{
  display:flex;
  gap:15px;
}

@media(max-width:768px){
  .menu{display:none;}
}
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Nome da marca",
      "default": "Jade Intimates"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}