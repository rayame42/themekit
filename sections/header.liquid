<header class="header-luxo">
  <div class="header-wrap">

    <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="logo">
      <a href="/">
        {% if settings.logo %}
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="height:{{ settings.logo_height }}px;width:auto;display:block;max-width:none;min-height:{{ settings.logo_height }}px;">
        {% else %}
          {{ section.settings.logo_text }}
        {% endif %}
      </a>
    </div>

    <nav class="menu">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="icons">
      <a href="/search" aria-label="Buscar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="#111" stroke-width="1.5"/>
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="#111" stroke-width="1.5"/>
        </svg>
      </a>
      <a href="/account" aria-label="Conta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="8" r="4" stroke="#111" stroke-width="1.5"/>
          <path d="M4 20c2-4 14-4 16 0" stroke="#111" stroke-width="1.5"/>
        </svg>
      </a>
      <a href="/cart" aria-label="Carrinho" class="cart-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="9" cy="20" r="1.5" stroke="#111" stroke-width="1.5"/>
          <circle cx="17" cy="20" r="1.5" stroke="#111" stroke-width="1.5"/>
          <path d="M3 4h2l2.5 10h11l2-7H6" stroke="#111" stroke-width="1.5"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>

  </div>

  <nav class="menu-mobile" id="menuMobile">
    {% for link in linklists[section.settings.menu].links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  </nav>

</header>

<style>
.header-luxo{position:sticky;top:0;z-index:999;background:#fff;border-bottom:1px solid #eee}
.header-wrap{max-width:1200px;margin:auto;padding:15px 20px;display:flex;align-items:center;justify-content:space-between}
.logo a{font-size:18px;letter-spacing:2px;text-decoration:none;color:#111;display:flex;align-items:center}
.menu{display:flex;gap:25px}
.menu a{text-decoration:none;font-size:12px;color:#111;letter-spacing:1px}
.icons{display:flex;gap:15px;align-items:center}
.cart-icon{position:relative;display:flex;align-items:center}
.cart-count{position:absolute;top:-8px;right:-8px;background:#2b0000;color:#fff;font-size:10px;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:600}
.hamburger{display:none;flex-direction:column;gap:5px;background:none!important;border:none!important;padding:0!important;cursor:pointer;border-radius:0!important}
.hamburger span{display:block;width:22px;height:2px;background:#111;border-radius:2px;transition:0.3s}
.menu-mobile{display:none;flex-direction:column;background:#fff;border-top:1px solid #eee;padding:16px 20px;gap:0}
.menu-mobile a{text-decoration:none;font-size:14px;color:#111;letter-spacing:1px;padding:12px 0;border-bottom:1px solid #f0f0f0}
.menu-mobile a:last-child{border-bottom:none}
.menu-mobile.active{display:flex}

@media(max-width:768px){
  .menu{display:none}
  .hamburger{display:flex}
  .header-wrap{position:relative}
  .logo{position:absolute;left:50%;transform:translateX(-50%)}
}
</style>

<script>
function toggleMenu(){
  document.getElementById('menuMobile').classList.toggle('active');
}
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Nome da marca (se não tiver logo)",
      "default": "Jade Intimates"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}