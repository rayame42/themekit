<section class="footer-premium">

  <div class="footer-container">

    <div class="footer-col">
      <h3>{{ section.settings.col1_title }}</h3>
      <a href="{{ section.settings.link1 }}">{{ section.settings.text1 }}</a>
      <a href="{{ section.settings.link2 }}">{{ section.settings.text2 }}</a>
      <a href="{{ section.settings.link3 }}">{{ section.settings.text3 }}</a>
      <a href="{{ section.settings.link4 }}">{{ section.settings.text4 }}</a>
      <a href="{{ section.settings.link5 }}">{{ section.settings.text5 }}</a>
      <a href="{{ section.settings.link6 }}">{{ section.settings.text6 }}</a>
    </div>

    <div class="footer-col">
      <h3>{{ section.settings.col2_title }}</h3>
      <a href="{{ section.settings.social1 }}">{{ section.settings.social1_text }}</a>
      <a href="{{ section.settings.social2 }}">{{ section.settings.social2_text }}</a>
      <a href="{{ section.settings.social3 }}">{{ section.settings.social3_text }}</a>
    </div>

    <div class="footer-col">
      <h3>{{ section.settings.col3_title }}</h3>
      <p>{{ section.settings.atendimento }}</p>
      <p><strong>Whatsapp:</strong> {{ section.settings.whatsapp }}</p>
      <p><strong>E-mail:</strong> {{ section.settings.email }}</p>
    </div>

  </div>

  <div class="footer-bottom">

    <!-- PAGAMENTO -->
    <div class="footer-bottom-group">
      <p class="footer-bottom-title">Formas de pagamento</p>
      <div class="footer-icons payment-icons">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {% endfor %}
      </div>
    </div>

    <!-- ENVIO -->
    {% if section.settings.envio1 or section.settings.envio2 or section.settings.envio3 %}
    <div class="footer-bottom-group">
      <p class="footer-bottom-title">Meios de envio</p>
      <div class="footer-icons">
        {% if section.settings.envio1 %}
          <img src="{{ section.settings.envio1 | image_url: width: 120 }}" alt="Envio" class="footer-logo">
        {% endif %}
        {% if section.settings.envio2 %}
          <img src="{{ section.settings.envio2 | image_url: width: 120 }}" alt="Envio" class="footer-logo">
        {% endif %}
        {% if section.settings.envio3 %}
          <img src="{{ section.settings.envio3 | image_url: width: 120 }}" alt="Envio" class="footer-logo">
        {% endif %}
      </div>
    </div>
    {% endif %}

    <!-- SEGURANÇA -->
    {% if section.settings.seg1 or section.settings.seg2 or section.settings.seg3 or section.settings.seg4 %}
    <div class="footer-bottom-group">
      <p class="footer-bottom-title">Segurança</p>
      <div class="footer-icons">
        {% if section.settings.seg1 %}
          <img src="{{ section.settings.seg1 | image_url: width: 120 }}" alt="Segurança" class="footer-logo">
        {% endif %}
        {% if section.settings.seg2 %}
          <img src="{{ section.settings.seg2 | image_url: width: 120 }}" alt="Segurança" class="footer-logo">
        {% endif %}
        {% if section.settings.seg3 %}
          <img src="{{ section.settings.seg3 | image_url: width: 120 }}" alt="Segurança" class="footer-logo">
        {% endif %}
        {% if section.settings.seg4 %}
          <img src="{{ section.settings.seg4 | image_url: width: 120 }}" alt="Segurança" class="footer-logo">
        {% endif %}
      </div>
    </div>
    {% endif %}

  </div>

</section>

<style>
.footer-premium{
  background:linear-gradient(180deg,#2b0000 0%,#1a0000 100%);
  color:#fff;
  padding:60px 20px 40px;
}

.footer-container{
  max-width:1100px;
  margin:auto;
  padding:0 20px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:40px;
}

.footer-col h3{
  margin-bottom:16px;
  font-size:14px;
  letter-spacing:2px;
  text-transform:uppercase;
  font-weight:500;
}

.footer-col a{
  display:block;
  margin-bottom:10px;
  color:#cfcfcf;
  text-decoration:none;
  font-size:14px;
  transition:0.3s;
}

.footer-col a:hover{
  color:#fff;
  transform:translateX(6px);
}

.footer-col p{
  font-size:14px;
  line-height:1.8;
  opacity:0.85;
}

.footer-col{
  padding-right:10px;
}

/* BOTTOM */
.footer-bottom{
  max-width:1100px;
  margin:40px auto 0;
  padding:30px 20px 0;
  border-top:1px solid rgba(255,255,255,0.1);
  display:flex;
  flex-direction:column;
  gap:24px;
}

.footer-bottom-group{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:14px;
}

.footer-bottom-title{
  font-size:12px;
  letter-spacing:2px;
  text-transform:uppercase;
  opacity:0.6;
  margin:0;
}

.footer-icons{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  align-items:center;
  gap:10px;
}

.payment-icon{
  height:28px;
  width:auto;
  background:#fff;
  border-radius:4px;
  padding:3px 6px;
}

.footer-logo{
  height:36px;
  width:auto;
  object-fit:contain;
  background:#fff;
  border-radius:6px;
  padding:4px 8px;
}

@media(max-width:768px){

  .footer-premium{
    padding:40px 16px 30px;
  }

  .footer-container{
    grid-template-columns:1fr;
    gap:16px;
    text-align:center;
    padding:0 10px;
  }

  .footer-col a:hover{
    transform:none;
  }

  .footer-bottom{
    margin-top:30px;
    padding-top:24px;
  }

}
</style>

{% schema %}
{
  "name": "Footer Premium",
  "settings": [
    { "type": "text", "id": "col1_title", "label": "Título coluna 1", "default": "Loja" },
    { "type": "text", "id": "text1", "label": "Texto 1", "default": "Início" },
    { "type": "url", "id": "link1", "label": "Link 1" },
    { "type": "text", "id": "text2", "label": "Texto 2", "default": "Catálogo" },
    { "type": "url", "id": "link2", "label": "Link 2" },
    { "type": "text", "id": "text3", "label": "Texto 3", "default": "Conjuntos" },
    { "type": "url", "id": "link3", "label": "Link 3" },
    { "type": "text", "id": "text4", "label": "Texto 4", "default": "Body" },
    { "type": "url", "id": "link4", "label": "Link 4" },
    { "type": "text", "id": "text5", "label": "Texto 5", "default": "Camisolas" },
    { "type": "url", "id": "link5", "label": "Link 5" },
    { "type": "text", "id": "text6", "label": "Texto 6", "default": "Corset" },
    { "type": "url", "id": "link6", "label": "Link 6" },
    { "type": "text", "id": "col2_title", "label": "Título coluna 2", "default": "Conecte-se" },
    { "type": "text", "id": "social1_text", "label": "Social 1", "default": "Facebook" },
    { "type": "url", "id": "social1", "label": "Link Facebook" },
    { "type": "text", "id": "social2_text", "label": "Social 2", "default": "Instagram" },
    { "type": "url", "id": "social2", "label": "Link Instagram" },
    { "type": "text", "id": "social3_text", "label": "Social 3", "default": "TikTok" },
    { "type": "url", "id": "social3", "label": "Link TikTok" },
    { "type": "text", "id": "col3_title", "label": "Título coluna 3", "default": "Central de Atendimento" },
    { "type": "textarea", "id": "atendimento", "label": "Texto atendimento", "default": "Atendimento via Whatsapp: Segunda à sexta (exceto fins de semana e feriados)." },
    { "type": "text", "id": "whatsapp", "label": "Whatsapp", "default": "(21) 96677-6897" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "contato@jadeintimates.com.br" },
    { "type": "header", "content": "Meios de Envio" },
    { "type": "image_picker", "id": "envio1", "label": "Logo envio 1" },
    { "type": "image_picker", "id": "envio2", "label": "Logo envio 2" },
    { "type": "image_picker", "id": "envio3", "label": "Logo envio 3" },
    { "type": "header", "content": "Segurança" },
    { "type": "image_picker", "id": "seg1", "label": "Selo segurança 1" },
    { "type": "image_picker", "id": "seg2", "label": "Selo segurança 2" },
    { "type": "image_picker", "id": "seg3", "label": "Selo segurança 3" },
    { "type": "image_picker", "id": "seg4", "label": "Selo segurança 4" }
  ],
  "presets": [
    { "name": "Footer Premium" }
  ]
}
{% endschema %}