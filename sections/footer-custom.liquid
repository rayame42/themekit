<section class="footer-premium">

  <div class="footer-container">

    <!-- COLUNA 1 -->
    <div class="footer-col">
      <h3>{{ section.settings.col1_title }}</h3>

      <a href="{{ section.settings.link1 }}">{{ section.settings.text1 }}</a>
      <a href="{{ section.settings.link2 }}">{{ section.settings.text2 }}</a>
      <a href="{{ section.settings.link3 }}">{{ section.settings.text3 }}</a>
      <a href="{{ section.settings.link4 }}">{{ section.settings.text4 }}</a>
      <a href="{{ section.settings.link5 }}">{{ section.settings.text5 }}</a>
      <a href="{{ section.settings.link6 }}">{{ section.settings.text6 }}</a>
    </div>

    <!-- COLUNA 2 -->
    <div class="footer-col">
      <h3>{{ section.settings.col2_title }}</h3>

      <a href="{{ section.settings.social1 }}">{{ section.settings.social1_text }}</a>
      <a href="{{ section.settings.social2 }}">{{ section.settings.social2_text }}</a>
      <a href="{{ section.settings.social3 }}">{{ section.settings.social3_text }}</a>
    </div>

    <!-- COLUNA 3 -->
    <div class="footer-col">
      <h3>{{ section.settings.col3_title }}</h3>

      <p>{{ section.settings.atendimento }}</p>
      <p><strong>Whatsapp:</strong> {{ section.settings.whatsapp }}</p>
      <p><strong>E-mail:</strong> {{ section.settings.email }}</p>
    </div>

  </div>

</section>

<style>
<style>
.footer-premium{
  background: linear-gradient(180deg,#2b0000 0%, #1a0000 100%);
  color:#fff;
  padding:100px 20px 60px;
  position:relative;
  overflow:hidden;
}

/* glow */
.footer-premium::before{
  content:"";
  position:absolute;
  top:-100px;
  left:-100px;
  width:300px;
  height:300px;
  background:rgba(255,255,255,0.03);
  filter:blur(80px);
  border-radius:50%;
}

/* GRID DESKTOP */
.footer-container{
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:80px;
}

/* TITULOS */
.footer-col h3{
  margin-bottom:18px;
  font-size:16px;
  letter-spacing:2px;
  text-transform:uppercase;
  font-weight:500;
}

/* LINKS */
.footer-col a{
  display:block;
  margin-bottom:10px;
  color:#cfcfcf;
  text-decoration:none;
  font-size:14px;
  transition:all 0.3s ease;
}

.footer-col a:hover{
  color:#ffffff;
  transform:translateX(6px);
}

/* TEXTOS */
.footer-col p{
  font-size:14px;
  line-height:1.7;
  opacity:0.85;
}

/* LINHA */
.footer-premium::after{
  content:"";
  display:block;
  width:100%;
  height:1px;
  background:rgba(255,255,255,0.08);
  margin-top:60px;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

  .footer-premium{
    padding:60px 20px 40px;
  }

  .footer-container{
    display:flex;
    flex-direction:column;
    gap:35px;
    text-align:center;
  }

  .footer-col h3{
    font-size:14px;
    letter-spacing:1px;
  }

  .footer-col a{
    font-size:14px;
    margin-bottom:8px;
  }

  .footer-col p{
    font-size:13px;
  }

  /* remove movimento lateral no mobile */
  .footer-col a:hover{
    transform:none;
  }

}

/* ================= MOBILE PEQUENO ================= */

@media(max-width:480px){

  .footer-premium{
    padding:50px 15px;
  }

  .footer-col h3{
    font-size:13px;
  }

  .footer-col a{
    font-size:13px;
  }

}
</style>

