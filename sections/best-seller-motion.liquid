<section class="best-editorial">

  <div class="best-container">

    <div class="best-head">
      <span>{{ section.settings.kicker }}</span>
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>

    <div class="best-grid">

      <a href="{{ section.settings.main_link }}" class="best-main">
        <img src="{{ section.settings.main_image | image_url: width: 1200 }}" alt="">
        <div class="best-overlay">
          <small>{{ section.settings.main_label }}</small>
          <strong>{{ section.settings.main_cta }}</strong>
        </div>
      </a>

      <div class="best-side">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="best-card" {{ block.shopify_attributes }}>
            <img src="{{ block.settings.img | image_url: width: 700 }}" alt="">
            <div class="best-card-text">
              <span>{{ block.settings.title }}</span>
              <small>{{ block.settings.cta }}</small>
            </div>
          </a>
        {% endfor %}
      </div>

    </div>

  </div>

</section>

<style>
.best-editorial{
  background:#f7f7f7;
  padding:110px 20px;
}

.best-container{
  max-width:1180px;
  margin:auto;
}

.best-head{
  text-align:center;
  margin-bottom:55px;
}

.best-head span{
  font-size:11px;
  letter-spacing:3px;
  text-transform:uppercase;
  color:#7a6a6a;
}

.best-head h2{
  font-size:42px;
  font-weight:300;
  letter-spacing:2px;
  margin:12px 0;
}

.best-head p{
  font-size:15px;
  color:#666;
}

.best-grid{
  display:grid;
  grid-template-columns:1.25fr .9fr;
  gap:22px;
  align-items:stretch;
}

.best-main,
.best-card{
  position:relative;
  overflow:hidden;
  border-radius:22px;
  display:block;
  text-decoration:none;
  color:#fff;
  background:#ddd;
}

.best-main img,
.best-card img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .7s ease;
}

.best-main{
  min-height:620px;
}

.best-side{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.best-card{
  min-height:300px;
}

.best-overlay,
.best-card-text{
  position:absolute;
  left:24px;
  right:24px;
  bottom:24px;
  z-index:2;
}

.best-main::after,
.best-card::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(to top,rgba(0,0,0,.62),rgba(0,0,0,.05),transparent);
}

.best-overlay small,
.best-card-text small{
  display:block;
  font-size:11px;
  letter-spacing:2px;
  text-transform:uppercase;
  opacity:.9;
  margin-top:7px;
}

.best-overlay strong,
.best-card-text span{
  font-size:18px;
  letter-spacing:1px;
  font-weight:400;
}

.best-main:hover img,
.best-card:hover img{
  transform:scale(1.06);
}

@media(max-width:768px){
  .best-editorial{
    padding:70px 16px;
  }

  .best-head{
    margin-bottom:34px;
  }

  .best-head h2{
    font-size:30px;
  }

  .best-grid{
    display:block;
  }

  .best-main{
    min-height:430px;
    margin-bottom:16px;
  }

  .best-side{
    display:flex;
    overflow-x:auto;
    gap:14px;
    padding-bottom:6px;
    scroll-snap-type:x mandatory;
  }

  .best-side::-webkit-scrollbar{
    display:none;
  }

  .best-card{
    min-width:72%;
    min-height:320px;
    scroll-snap-align:start;
  }

  .best-overlay,
  .best-card-text{
    left:18px;
    right:18px;
    bottom:18px;
  }
}
</style>

{% schema %}
{
  "name": "Best Seller Editorial",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Texto pequeno acima",
      "default": "CURADORIA JADE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "BEST SELLERS | TOP 04"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Peças que deixam marca — nas fotos, na memória e na pele."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Imagem principal"
    },
    {
      "type": "url",
      "id": "main_link",
      "label": "Link da imagem principal"
    },
    {
      "type": "text",
      "id": "main_label",
      "label": "Texto na imagem principal",
      "default": "Mais desejado"
    },
    {
      "type": "text",
      "id": "main_cta",
      "label": "CTA imagem principal",
      "default": "Explorar agora →"
    }
  ],
  "blocks": [
    {
      "type": "produto",
      "name": "Produto",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Peça destaque"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA",
          "default": "Comprar →"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Best Seller Editorial"
    }
  ]
}
{% endschema %}