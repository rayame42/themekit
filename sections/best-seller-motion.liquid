<section class="best-lux">

  <div class="container">

    <div class="top">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>

    <div class="grid">

      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="card">

          <img src="{{ block.settings.img | image_url: width: 900 }}">

          <div class="hover">
            <span>Comprar →</span>
          </div>

        </a>
      {% endfor %}

    </div>

  </div>

</section>

<style>

/* BASE */
.best-lux{
  padding:100px 20px;
  background:#f5f5f5;
}

.container{
  max-width:1200px;
  margin:auto;
}

/* HEADER */
.top{
  text-align:center;
  margin-bottom:50px;
}

.top h2{
  font-size:34px;
  letter-spacing:2px;
  font-weight:400;
}

.top p{
  font-size:14px;
  color:#666;
  margin-top:10px;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

/* CARD */
.card{
  position:relative;
  overflow:hidden;
  border-radius:18px;
}

.card img{
  width:100%;
  height:420px;
  object-fit:cover;
  transition:0.5s ease;
}

/* HOVER */
.hover{
  position:absolute;
  inset:0;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  padding:25px;
  background:linear-gradient(to top, rgba(0,0,0,0.6), transparent);
  opacity:0;
  transition:0.4s;
}

.hover span{
  background:#fff;
  color:#000;
  padding:10px 22px;
  font-size:12px;
  letter-spacing:2px;
}

/* ANIMAÇÃO */
.card:hover img{
  transform:scale(1.06);
}

.card:hover .hover{
  opacity:1;
}

/* ===== MOBILE PREMIUM ===== */
@media(max-width:768px){

  .grid{
    display:flex;
    overflow-x:auto;
    gap:14px;
    padding:0 10px;
  }

  .grid::-webkit-scrollbar{
    display:none;
  }

  .card{
    min-width:75%;
    flex:0 0 75%;
  }

  .card img{
    height:360px;
  }

  /* BOTÃO SEM PRECISAR HOVER */
  .hover{
    opacity:1;
    background:linear-gradient(to top, rgba(0,0,0,0.5), transparent);
  }

}

</style>

{% schema %}
{
  "name": "Best Seller Luxo",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "BEST SELLERS | TOP 04"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "As peças mais desejadas da coleção."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Produto",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Best Seller Luxo"
    }
  ]
}
{% endschema %}