<section class="lux-section">

  <div class="lux-container">

    <!-- IMAGENS -->
    <div class="lux-images">

      <!-- PRINCIPAL -->
      <div class="img main">
        <img src="{{ section.settings.main_image | image_url: width: 800 }}">
      </div>

      <!-- LATERAIS -->
      <div class="img img1">
        <img src="{{ section.settings.img1 | image_url: width: 400 }}">
      </div>

      <div class="img img2">
        <img src="{{ section.settings.img2 | image_url: width: 400 }}">
      </div>

      <div class="img img3">
        <img src="{{ section.settings.img3 | image_url: width: 400 }}">
      </div>

      <div class="img img4">
        <img src="{{ section.settings.img4 | image_url: width: 400 }}">
      </div>

    </div>

    <!-- TEXTO -->
    <div class="lux-text">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
      <a href="{{ section.settings.button_link }}" class="btn">
        {{ section.settings.button_text }}
      </a>
    </div>

  </div>

</section>

<style>

/* FUNDO */
.lux-section{
  background:#f4f4f4;
  padding:100px 20px;
}

/* GRID */
.lux-container{
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:60px;
}

/* ÁREA DAS IMAGENS */
.lux-images{
  position:relative;
  height:600px;
}

/* BASE */
.img{
  position:absolute;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 20px 50px rgba(0,0,0,0.15);
  opacity:0;
  transform:scale(0.9);
  animation:fadeUp 0.8s ease forwards;
}

.img img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

/* PRINCIPAL */
.main{
  width:320px;
  height:420px;
  left:50%;
  top:50%;
  transform:translate(-50%, -50%) scale(0.9);
  z-index:5;
  animation-delay:0.2s;
}

/* LATERAIS (ORGANIZADAS) */

.img1{
  width:160px;
  top:40px;
  left:40px;
  animation-delay:0.4s;
}

.img2{
  width:150px;
  top:60px;
  right:20px;
  animation-delay:0.6s;
}

.img3{
  width:150px;
  bottom:40px;
  left:60px;
  animation-delay:0.8s;
}

.img4{
  width:160px;
  bottom:10px;
  right:10px;
  animation-delay:1s;
}

/* ANIMAÇÃO */
@keyframes fadeUp{
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

/* TEXTO */
.lux-text h2{
  font-size:32px;
  font-weight:400;
  letter-spacing:2px;
  margin-bottom:15px;
}

.lux-text p{
  font-size:15px;
  color:#555;
  margin-bottom:25px;
  max-width:400px;
}

/* BOTÃO */
.btn{
  background:#111;
  color:#fff;
  padding:14px 28px;
  text-decoration:none;
  font-size:13px;
  letter-spacing:2px;
  display:inline-block;
  transition:0.3s;
}

.btn:hover{
  background:#2b0000;
}

/* MOBILE */
@media(max-width:768px){

  .lux-container{
    grid-template-columns:1fr;
    text-align:center;
  }

  .lux-images{
    height:500px;
  }

  .main{
    width:260px;
    height:340px;
  }

}

</style>

{% schema %}
{
  "name": "Best Seller Premium",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem 1 (topo esquerda)" },
    { "type": "image_picker", "id": "img2", "label": "Imagem 2 (topo direita)" },
    { "type": "image_picker", "id": "img3", "label": "Imagem 3 (baixo esquerda)" },
    { "type": "image_picker", "id": "img4", "label": "Imagem 4 (baixo direita)" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS | TOP 05" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Peças que deixaram marca — nas fotos, na memória e na cama." },
    { "type": "text", "id": "button_text", "label": "Texto botão", "default": "EXPLORAR →" },
    { "type": "url", "id": "button_link", "label": "Link botão" }
  ],
  "presets": [
    { "name": "Best Seller Premium" }
  ]
}
{% endschema %}