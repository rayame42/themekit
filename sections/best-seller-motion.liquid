<section class="motion-section">

<div class="motion-container">

  <!-- IMAGEM PRINCIPAL -->
  <div class="main-img">
    <img src="{{ section.settings.main_image | image_url: width: 900 }}">
  </div>

  <!-- LATERAIS -->
  <div class="side left-top">
    <img src="{{ section.settings.img1 | image_url: width: 500 }}">
  </div>

  <div class="side right-top">
    <img src="{{ section.settings.img2 | image_url: width: 500 }}">
  </div>

  <div class="side left-bottom">
    <img src="{{ section.settings.img3 | image_url: width: 500 }}">
  </div>

  <div class="side right-bottom">
    <img src="{{ section.settings.img4 | image_url: width: 500 }}">
  </div>

</div>

<div class="motion-text">
  <h2>{{ section.settings.title }}</h2>
  <p>{{ section.settings.subtitle }}</p>
</div>

</section>

<style>

.motion-section{
  background:#2b0000;
  padding:100px 20px;
  text-align:center;
  color:#fff;
}

/* CONTAINER */
.motion-container{
  position:relative;
  max-width:500px;
  margin:80px auto;
  overflow:visible;
}

/* IMAGEM PRINCIPAL */
.main-img{
  position:relative;
  z-index:1;
  animation:fadeMain 1s ease forwards;
}

.main-img img{
  width:260px; /* 🔥 menor */
  height:360px;
  object-fit:cover;
  border-radius:20px;
  display:block;
  margin:auto;
  box-shadow:0 20px 60px rgba(0,0,0,0.4);
}

/* LATERAIS (POR CIMA) */
.side{
  position:absolute;
  z-index:10; /* 🔥 FICA NA FRENTE */
  opacity:0;
}

/* POSIÇÕES */
.left-top{
  top:20px;
  left:-140px;
  animation:showLeftTop 1s ease forwards;
  animation-delay:0.4s;
}

.right-top{
  top:20px;
  right:-140px;
  animation:showRightTop 1s ease forwards;
  animation-delay:0.6s;
}

.left-bottom{
  bottom:20px;
  left:-160px;
  animation:showLeftBottom 1s ease forwards;
  animation-delay:0.8s;
}

.right-bottom{
  bottom:20px;
  right:-160px;
  animation:showRightBottom 1s ease forwards;
  animation-delay:1s;
}

/* TAMANHO DAS LATERAIS */
.side img{
  width:140px;
  height:190px;
  object-fit:cover;
  border-radius:15px;
  box-shadow:0 15px 40px rgba(0,0,0,0.3);
}

/* ANIMAÇÕES WOW */
@keyframes fadeMain{
  from{
    opacity:0;
    transform:scale(0.9);
  }
  to{
    opacity:1;
    transform:scale(1);
  }
}

@keyframes showLeftTop{
  from{
    opacity:0;
    transform:translate(-60px,60px) scale(0.9);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
  }
}

@keyframes showRightTop{
  from{
    opacity:0;
    transform:translate(60px,60px) scale(0.9);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
  }
}

@keyframes showLeftBottom{
  from{
    opacity:0;
    transform:translate(-60px,-60px) scale(0.9);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
  }
}

@keyframes showRightBottom{
  from{
    opacity:0;
    transform:translate(60px,-60px) scale(0.9);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
  }
}

/* TEXTO */
.motion-text{
  margin-top:70px;
}

.motion-text h2{
  font-size:28px;
  letter-spacing:2px;
  margin-bottom:10px;
}

.motion-text p{
  font-size:14px;
  opacity:0.8;
}

/* MOBILE */
@media(max-width:768px){

  .main-img img{
    width:200px;
    height:280px;
  }

  .side img{
    width:90px;
    height:130px;
  }

  .left-top{ left:-70px; }
  .right-top{ right:-70px; }
  .left-bottom{ left:-80px; }
  .right-bottom{ right:-80px; }

}

</style>