<section class="best-editorial">

  <div class="editorial-container">

    <!-- ESQUERDA -->
    <div class="left">
      {% if section.settings.img1 != blank %}
        <img src="{{ section.settings.img1 | image_url: width: 600 }}">
      {% endif %}

      {% if section.settings.img2 != blank %}
        <img src="{{ section.settings.img2 | image_url: width: 600 }}">
      {% endif %}
    </div>

    <!-- PRINCIPAL -->
    <div class="center">
      {% if section.settings.main_image != blank %}
        <img src="{{ section.settings.main_image | image_url: width: 900 }}">
      {% endif %}
    </div>

  </div>

  <div class="text">
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.subtitle }}</p>
  </div>

</section>

<style>

/* FUNDO */
.best-editorial{
  background:#2b0000;
  padding:100px 20px;
  text-align:center;
  color:#fff;
}

/* GRID */
.editorial-container{
  display:grid;
  grid-template-columns: 1fr 1.5fr;
  gap:30px;
  max-width:1000px;
  margin:auto;
  align-items:center;
}

/* ESQUERDA */
.left{
  display:flex;
  flex-direction:column;
  gap:20px;
}

.left img{
  width:100%;
  height:260px;
  object-fit:cover;
  border-radius:16px;
  transition:0.4s;
}

/* CENTRO */
.center img{
  width:100%;
  height:540px;
  object-fit:cover;
  border-radius:20px;
  box-shadow:0 30px 80px rgba(0,0,0,0.5);
  transition:0.4s;
}

/* HOVER PREMIUM */
.left img:hover,
.center img:hover{
  transform:scale(1.03);
}

/* TEXTO */
.text{
  margin-top:60px;
}

.text h2{
  font-size:28px;
  letter-spacing:2px;
}

.text p{
  font-size:14px;
  opacity:0.8;
}

/* MOBILE */
@media(max-width:768px){

  .editorial-container{
    grid-template-columns:1fr;
  }

  .center img{
    height:400px;
  }

  .left img{
    height:180px;
  }

}

</style>

{% schema %}
{
  "name": "Best Seller Editorial",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem lateral 1" },
    { "type": "image_picker", "id": "img2", "label": "Imagem lateral 2" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "As peças mais desejadas da coleção." }
  ],
  "presets": [
    { "name": "Best Seller Editorial" }
  ]
}
{% endschema %}