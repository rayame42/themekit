<section class="motion-section">

  <div class="motion-container">

    <!-- IMAGEM PRINCIPAL -->
    <div class="main-img">
      <img src="{{ section.settings.main_image | image_url: width: 900 }}">
    </div>

    <!-- LATERAIS -->
    <div class="side s1">
      <img src="{{ section.settings.img1 | image_url: width: 500 }}">
    </div>

    <div class="side s2">
      <img src="{{ section.settings.img2 | image_url: width: 500 }}">
    </div>

    <div class="side s3">
      <img src="{{ section.settings.img3 | image_url: width: 500 }}">
    </div>

    <div class="side s4">
      <img src="{{ section.settings.img4 | image_url: width: 500 }}">
    </div>

  </div>

  <div class="motion-text">
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.subtitle }}</p>
  </div>

</section>

<style>

/* FUNDO */
.motion-section{
  background:#2b0000;
  padding:100px 20px;
  text-align:center;
  color:#fff;
}

/* CONTAINER */
.motion-container{
  position:relative;
  width:320px;
  margin:80px auto;
}

/* PRINCIPAL */
.main-img{
  position:relative;
  z-index:1;
  transform: translateZ(0); /* 🔥 resolve bug de camada */
}
.main-img img{
  width:220px;
  height:300px;
  object-fit:cover;
  border-radius:20px;
  display:block;
  margin:auto;
  box-shadow:0 20px 60px rgba(0,0,0,0.4);
}

/* LATERAIS (NA FRENTE) */
.side{
  position:absolute;
  z-index:10;
  opacity:0;
  animation:fadeUp 0.8s ease forwards;
}

/* TAMANHO */
.side img{
  width:130px;
  height:180px;
  object-fit:cover;
  border-radius:15px;
  box-shadow:0 15px 40px rgba(0,0,0,0.3);
}

/* POSIÇÕES */
.s1{ top:-20px; left:-120px; animation-delay:0.2s; }
.s2{ top:-20px; right:-120px; animation-delay:0.4s; }
.s3{ bottom:-20px; left:-130px; animation-delay:0.6s; }
.s4{ bottom:-20px; right:-130px; animation-delay:0.8s; }

/* ANIMAÇÃO */
@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(30px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* TEXTO */
.motion-text{
  margin-top:70px;
}

.motion-text h2{
  font-size:26px;
  letter-spacing:2px;
  margin-bottom:10px;
}

.motion-text p{
  font-size:14px;
  opacity:0.8;
}

/* MOBILE */
@media(max-width:768px){

  .motion-container{
    width:260px;
  }

  .main-img img{
    width:180px;
    height:250px;
  }

  .side img{
    width:90px;
    height:130px;
  }

  .s1{ left:-70px; }
  .s2{ right:-70px; }
  .s3{ left:-80px; }
  .s4{ right:-80px; }

}

</style>

{% schema %}
{
  "name": "Best Seller Motion",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem 1" },
    { "type": "image_picker", "id": "img2", "label": "Imagem 2" },
    { "type": "image_picker", "id": "img3", "label": "Imagem 3" },
    { "type": "image_picker", "id": "img4", "label": "Imagem 4" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS | TOP 05" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "As peças que marcaram presença." }
  ],
  "presets": [
    { "name": "Best Seller Motion" }
  ]
}
{% endschema %}