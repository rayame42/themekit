<section class="lux-final">

  <div class="wrap">

    <!-- IMAGENS -->
    <div class="images">

      <!-- PRINCIPAL -->
      <div class="main">
        <img src="{{ section.settings.main_image | image_url: width: 900 }}">
      </div>

      <!-- ESQUERDA -->
      <div class="img left-top">
        <img src="{{ section.settings.img1 | image_url: width: 400 }}">
      </div>

      <div class="img left-bottom">
        <img src="{{ section.settings.img3 | image_url: width: 400 }}">
      </div>

      <!-- DIREITA -->
      <div class="img right-top">
        <img src="{{ section.settings.img2 | image_url: width: 400 }}">
      </div>

      <div class="img right-bottom">
        <img src="{{ section.settings.img4 | image_url: width: 400 }}">
      </div>

    </div>

    <!-- TEXTO -->
    <div class="text">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>

      {% if section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

  </div>

</section>

<style>

/* FUNDO */
.lux-final{
  background:#f5f5f5;
  padding:120px 20px;
}

/* CONTAINER */
.wrap{
  max-width:1200px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:60px;
}

/* IMAGENS */
.images{
  position:relative;
  width:520px;
  height:500px;
}

/* PRINCIPAL */
.main{
  position:absolute;
  width:320px;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  z-index:3;
}

.main img{
  width:100%;
  border-radius:20px;
  box-shadow:0 30px 80px rgba(0,0,0,0.25);
}

/* LATERAIS BASE */
.img{
  position:absolute;
  width:150px;
  z-index:5;
}

.img img{
  width:100%;
  border-radius:16px;
  box-shadow:0 15px 40px rgba(0,0,0,0.15);
}

/* POSIÇÕES (PRÓXIMAS DA PRINCIPAL) */

/* esquerda */
.left-top{
  top:60px;
  left:-20px;
}

.left-bottom{
  bottom:60px;
  left:-20px;
}

/* direita */
.right-top{
  top:60px;
  right:-20px;
}

.right-bottom{
  bottom:60px;
  right:-20px;
}

/* HOVER PREMIUM */
.img:hover{
  transform:scale(1.08);
  transition:0.3s;
}

/* TEXTO */
.text{
  max-width:420px;
}

.text h2{
  font-size:34px;
  letter-spacing:2px;
  font-weight:400;
  margin-bottom:15px;
}

.text p{
  font-size:16px;
  color:#555;
  margin-bottom:25px;
}

/* BOTÃO */
.btn{
  background:#111;
  color:#fff;
  padding:14px 30px;
  text-decoration:none;
  font-size:13px;
  letter-spacing:2px;
  transition:0.3s;
}

.btn:hover{
  background:#2b0000;
}

/* MOBILE */
@media(max-width:768px){

  .wrap{
    flex-direction:column;
    text-align:center;
  }

  .images{
    width:100%;
    height:480px;
  }

}

</style>

{% schema %}
{
  "name": "Best Seller Final",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem esquerda topo" },
    { "type": "image_picker", "id": "img2", "label": "Imagem direita topo" },
    { "type": "image_picker", "id": "img3", "label": "Imagem esquerda baixo" },
    { "type": "image_picker", "id": "img4", "label": "Imagem direita baixo" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS | TOP 05" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Peças que deixam marca — nas fotos, na memória e na pele." },
    { "type": "text", "id": "button_text", "label": "Texto do botão", "default": "EXPLORAR →" },
    { "type": "url", "id": "button_link", "label": "Link do botão" }
  ],
  "presets": [
    { "name": "Best Seller Final" }
  ]
}
{% endschema %}