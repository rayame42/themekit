<section class="lux-final">

  <div class="wrap">

    <!-- IMAGENS -->
    <div class="images">

      <div class="main">
        <img src="{{ section.settings.main_image | image_url: width: 900 }}">
      </div>

      <div class="img">
        <img src="{{ section.settings.img1 | image_url: width: 500 }}">
      </div>

      <div class="img">
        <img src="{{ section.settings.img2 | image_url: width: 500 }}">
      </div>

      <div class="img">
        <img src="{{ section.settings.img3 | image_url: width: 500 }}">
      </div>

      <div class="img">
        <img src="{{ section.settings.img4 | image_url: width: 500 }}">
      </div>

    </div>

    <!-- TEXTO -->
    <div class="text">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>

      {% if section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

  </div>

</section>

<style>

/* FUNDO */
.lux-final{
  background:#f5f5f5;
  padding:100px 20px;
}

/* CONTAINER */
.wrap{
  max-width:1200px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:60px;
}

/* DESKTOP IMAGENS */
.images{
  position:relative;
  width:520px;
  height:500px;
}

/* PRINCIPAL */
.main{
  position:absolute;
  width:320px;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  z-index:3;
}

.main img{
  width:100%;
  border-radius:20px;
  box-shadow:0 30px 80px rgba(0,0,0,0.25);
}

/* LATERAIS */
.img{
  position:absolute;
  width:150px;
}

.img img{
  width:100%;
  border-radius:16px;
  box-shadow:0 15px 40px rgba(0,0,0,0.15);
}

/* POSIÇÕES */
.img:nth-child(2){ top:40px; left:-20px; }
.img:nth-child(3){ top:40px; right:-20px; }
.img:nth-child(4){ bottom:40px; left:-20px; }
.img:nth-child(5){ bottom:40px; right:-20px; }

/* TEXTO */
.text{
  max-width:420px;
}

.text h2{
  font-size:34px;
  letter-spacing:2px;
  font-weight:400;
  margin-bottom:15px;
}

.text p{
  font-size:16px;
  color:#555;
  margin-bottom:25px;
}

/* BOTÃO */
.btn{
  background:#111;
  color:#fff;
  padding:14px 30px;
  text-decoration:none;
  font-size:13px;
  letter-spacing:2px;
  transition:0.3s;
}

.btn:hover{
  background:#2b0000;
}

/* ===== MOBILE (AGORA FICA BONITO) ===== */
@media(max-width:768px){

  .wrap{
    flex-direction:column;
    gap:30px;
    text-align:center;
  }

  /* TRANSFORMA EM CARROSSEL */
  .images{
    position:relative;
    width:100%;
    height:auto;
    display:flex;
    overflow-x:auto;
    gap:12px;
    padding:10px;
  }

  .images::-webkit-scrollbar{
    display:none;
  }

  /* REMOVE POSIÇÃO ABSOLUTA */
  .main,
  .img{
    position:relative !important;
    transform:none !important;
    width:75%;
    flex:0 0 75%;
  }

  .main img,
  .img img{
    width:100%;
    border-radius:16px;
  }

  /* TEXTO */
  .text h2{
    font-size:24px;
  }

  .text p{
    font-size:14px;
  }

  .btn{
    width:100%;
    display:block;
  }

}

</style>

{% schema %}
{
  "name": "Best Seller Final",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem 1" },
    { "type": "image_picker", "id": "img2", "label": "Imagem 2" },
    { "type": "image_picker", "id": "img3", "label": "Imagem 3" },
    { "type": "image_picker", "id": "img4", "label": "Imagem 4" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS | TOP 04" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "As peças mais desejadas da coleção." },
    { "type": "text", "id": "button_text", "label": "Texto do botão", "default": "EXPLORAR →" },
    { "type": "url", "id": "button_link", "label": "Link do botão" }
  ],
  "presets": [
    { "name": "Best Seller Final" }
  ]
}
{% endschema %}