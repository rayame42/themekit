<section class="best-seller-pro">

  <div class="container">

    <h2>{{ section.settings.title }}</h2>
    <p class="subtitle">{{ section.settings.subtitle }}</p>

    <!-- SLIDER -->
    <div class="slider" id="bestSlider">

      {% for block in section.blocks %}
        <div class="card">

          <img src="{{ block.settings.img | image_url: width: 800 }}">

          <div class="overlay">
            <a href="{{ block.settings.link }}" class="buy">
              Comprar →
            </a>
          </div>

        </div>
      {% endfor %}

    </div>

  </div>

</section>

<style>

/* FUNDO */
.best-seller-pro{
  padding:80px 20px;
  background:#f5f5f5;
}

/* CONTAINER */
.container{
  max-width:1200px;
  margin:auto;
  text-align:center;
}

/* TITULO */
.best-seller-pro h2{
  font-size:30px;
  letter-spacing:2px;
  margin-bottom:10px;
}

.subtitle{
  font-size:14px;
  color:#666;
  margin-bottom:30px;
}

/* SLIDER */
.slider{
  display:flex;
  gap:16px;
  overflow-x:auto;
  scroll-behavior:smooth;
}

.slider::-webkit-scrollbar{
  display:none;
}

/* CARD */
.card{
  position:relative;
  min-width:260px;
  flex:0 0 260px;
  border-radius:16px;
  overflow:hidden;
}

.card img{
  width:100%;
  height:360px;
  object-fit:cover;
  transition:0.4s;
}

/* OVERLAY */
.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.0);
  display:flex;
  align-items:flex-end;
  justify-content:center;
  padding:20px;
  transition:0.3s;
}

/* BOTÃO */
.buy{
  background:#fff;
  color:#000;
  padding:10px 20px;
  font-size:12px;
  letter-spacing:2px;
  text-decoration:none;
  opacity:0;
  transform:translateY(20px);
  transition:0.3s;
}

/* HOVER */
.card:hover img{
  transform:scale(1.05);
}

.card:hover .overlay{
  background:rgba(0,0,0,0.25);
}

.card:hover .buy{
  opacity:1;
  transform:translateY(0);
}

/* MOBILE */
@media(max-width:768px){

  .card{
    min-width:75%;
    flex:0 0 75%;
  }

  .card img{
    height:320px;
  }

  .buy{
    opacity:1;
    transform:none;
  }

}

</style>

<script>

/* AUTO SLIDE (ZARA STYLE) */
const slider = document.getElementById("bestSlider");

let scrollAmount = 0;

setInterval(() => {
  if (!slider) return;

  scrollAmount += 280;

  if (scrollAmount >= slider.scrollWidth - slider.clientWidth) {
    scrollAmount = 0;
  }

  slider.scrollTo({
    left: scrollAmount,
    behavior: "smooth"
  });

}, 2500);

</script>

{% schema %}
{
  "name": "Best Seller PRO",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "As peças mais desejadas da coleção." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Produto",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "url", "id": "link", "label": "Link produto" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Best Seller PRO"
    }
  ]
}
{% endschema %}