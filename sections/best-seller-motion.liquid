<section class="lux-section">

  <div class="lux-container">

    <!-- IMAGENS -->
    <div class="lux-images">

      <div class="img main">
        <img src="{{ section.settings.main_image | image_url: width: 900 }}">
      </div>

      <div class="img img1">
        <img src="{{ section.settings.img1 | image_url: width: 500 }}">
      </div>

      <div class="img img2">
        <img src="{{ section.settings.img2 | image_url: width: 500 }}">
      </div>

      <div class="img img3">
        <img src="{{ section.settings.img3 | image_url: width: 500 }}">
      </div>

      <div class="img img4">
        <img src="{{ section.settings.img4 | image_url: width: 500 }}">
      </div>

    </div>

    <!-- TEXTO -->
    <div class="lux-text">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>

      <a href="{{ section.settings.link }}" class="lux-btn">
        EXPLORAR →
      </a>
    </div>

  </div>

</section>

<style>

.lux-section{
  background:#f5f5f5;
  padding:100px 20px;
}

/* GRID MAIS ORGANIZADO */
.lux-container{
  max-width:1100px;
  margin:auto;
  display:grid;
  grid-template-columns:1.2fr 1fr;
  align-items:center;
  gap:60px;
}

/* ÁREA DAS IMAGENS */
.lux-images{
  position:relative;
  height:520px;
}

/* BASE */
.img{
  position:absolute;
  opacity:0;
  animation:fadeUp 0.8s ease forwards;
}

.img img{
  width:100%;
  border-radius:14px;
  object-fit:cover;
  box-shadow:0 20px 50px rgba(0,0,0,0.15);
}

/* PRINCIPAL (CENTRAL MAIS CONTROLADA) */
.main{
  width:280px;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  z-index:3;
  animation-delay:0.2s;
}

/* LATERAIS ORGANIZADAS */
.img1{
  width:160px;
  left:20px;
  top:20px;
  animation-delay:0.4s;
}

.img2{
  width:150px;
  right:20px;
  top:60px;
  animation-delay:0.6s;
}

.img3{
  width:160px;
  left:40px;
  bottom:20px;
  animation-delay:0.8s;
}

.img4{
  width:160px;
  right:30px;
  bottom:30px;
  animation-delay:1s;
}

/* TEXTO (NÃO CORTA MAIS) */
.lux-text{
  max-width:420px;
}

.lux-text h2{
  font-size:32px;
  letter-spacing:2px;
  font-weight:400;
  margin-bottom:20px;
}

.lux-text p{
  font-size:16px;
  color:#555;
  line-height:1.6;
  margin-bottom:25px;
}

/* BOTÃO */
.lux-btn{
  display:inline-block;
  background:#111;
  color:#fff;
  padding:14px 28px;
  text-decoration:none;
  font-size:13px;
  letter-spacing:1px;
  transition:0.3s;
}

.lux-btn:hover{
  background:#2b0000;
}

/* ANIMAÇÃO SUAVE */
@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(30px) scale(0.95);
  }
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}

/* MOBILE ARRUMADO */
@media(max-width:768px){

  .lux-container{
    grid-template-columns:1fr;
    text-align:center;
  }

  .lux-images{
    height:420px;
  }

  .main{
    width:220px;
  }

}

</style>

{% schema %}
{
  "name": "Best Seller Premium",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem 1" },
    { "type": "image_picker", "id": "img2", "label": "Imagem 2" },
    { "type": "image_picker", "id": "img3", "label": "Imagem 3" },
    { "type": "image_picker", "id": "img4", "label": "Imagem 4" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS | TOP 05" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Peças que deixam marca — nas fotos, na memória e na pele." },
    { "type": "url", "id": "link", "label": "Link do botão" }
  ],
  "presets": [
    { "name": "Best Seller Premium" }
  ]
}
{% endschema %}