<section class="motion-section">

<div class="motion-container">

  <!-- IMAGEM PRINCIPAL -->
  <div class="main-img">
    <img src="{{ section.settings.main_image | image_url: width: 900 }}">
  </div>

  <!-- IMAGENS LATERAIS -->
  <div class="side img1">
    <img src="{{ section.settings.img1 | image_url: width: 500 }}">
  </div>

  <div class="side img2">
    <img src="{{ section.settings.img2 | image_url: width: 500 }}">
  </div>

  <div class="side img3">
    <img src="{{ section.settings.img3 | image_url: width: 500 }}">
  </div>

  <div class="side img4">
    <img src="{{ section.settings.img4 | image_url: width: 500 }}">
  </div>

</div>

<div class="motion-text">
  <h2>{{ section.settings.title }}</h2>
  <p>{{ section.settings.subtitle }}</p>
</div>

</section>

<style>

.motion-section{
  background:#2b0000;
  padding:80px 20px;
  text-align:center;
  color:#fff;
}

.motion-container{
  max-width:700px;
}

/* PRINCIPAL */
.main-img{
  position:relative;
  z-index:2;
  animation:fadeMain 1s ease forwards;
}

.main-img img{
  width:260px;
  height:360px;
  object-fit:cover;
  border-radius:20px;
  display:block;
  margin:auto;
  box-shadow:0 20px 60px rgba(0,0,0,0.35);
}
/* LATERAIS */
.side{
  position:absolute;
}

.side img{
  width:120px;
  height:160px;
  object-fit:cover;
}

/* POSIÇÕES */
.img1{ top:0; left:-120px; }
.img2{ top:0; right:-120px; }
.img3{ bottom:0; left:-120px; }
.img4{ bottom:0; right:-120px; }

/* ANIMAÇÕES */
.img1{ animation:show1 1s ease forwards; animation-delay:0.5s; }
.img2{ animation:show2 1s ease forwards; animation-delay:0.8s; }
.img3{ animation:show3 1s ease forwards; animation-delay:1.1s; }
.img4{ animation:show4 1s ease forwards; animation-delay:1.4s; }

@keyframes fadeMain{
  from{opacity:0; transform:scale(0.95);}
  to{opacity:1; transform:scale(1);}
}

@keyframes show1{
  from{opacity:0; transform:translate(-40px,40px);}
  to{opacity:1; transform:translate(0,0);}
}

@keyframes show2{
  from{opacity:0; transform:translate(40px,40px);}
  to{opacity:1; transform:translate(0,0);}
}

@keyframes show3{
  from{opacity:0; transform:translate(-40px,-40px);}
  to{opacity:1; transform:translate(0,0);}
}

@keyframes show4{
  from{opacity:0; transform:translate(40px,-40px);}
  to{opacity:1; transform:translate(0,0);}
}

/* TEXTO */
.motion-text{
  margin-top:60px;
}

.motion-text h2{
  font-size:28px;
  letter-spacing:2px;
  margin-bottom:10px;
}

.motion-text p{
  font-size:14px;
  opacity:0.8;
}

/* MOBILE */
@media(max-width:768px){

  .side img{
    width:100px;
  }

  .img1{ left:-60px; }
  .img2{ right:-60px; }
  .img3{ left:-60px; }
  .img4{ right:-60px; }

}

</style>

{% schema %}
{
  "name": "Best Seller Motion",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem 1" },
    { "type": "image_picker", "id": "img2", "label": "Imagem 2" },
    { "type": "image_picker", "id": "img3", "label": "Imagem 3" },
    { "type": "image_picker", "id": "img4", "label": "Imagem 4" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS | TOP 05" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "As peças que marcaram presença." }
  ],
  "presets": [
    { "name": "Best Seller Motion" }
  ]
}
{% endschema %}