<section class="lux-clean">

  <div class="lux-wrapper">

    <!-- IMAGENS -->
    <div class="lux-grid">

      <div class="small">
        <img src="{{ section.settings.img1 | image_url: width: 400 }}">
      </div>

      <div class="small">
        <img src="{{ section.settings.img2 | image_url: width: 400 }}">
      </div>

      <div class="main">
        <img src="{{ section.settings.main_image | image_url: width: 800 }}">
      </div>

      <div class="small">
        <img src="{{ section.settings.img3 | image_url: width: 400 }}">
      </div>

      <div class="small">
        <img src="{{ section.settings.img4 | image_url: width: 400 }}">
      </div>

    </div>

    <!-- TEXTO -->
    <div class="lux-text">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>

      {% if section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

  </div>

</section>

<style>

/* FUNDO */
.lux-clean{
  background:#f5f5f5;
  padding:100px 20px;
}

/* CONTAINER */
.lux-wrapper{
  max-width:1100px;
  margin:auto;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:60px;
  align-items:center;
}

/* GRID DE IMAGENS */
.lux-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}

/* IMAGEM PRINCIPAL */
.main{
  grid-column:span 2;
}

.main img{
  width:100%;
  border-radius:20px;
  box-shadow:0 20px 50px rgba(0,0,0,0.2);
  animation:fade 0.8s ease;
}

/* IMAGENS PEQUENAS */
.small img{
  width:100%;
  border-radius:16px;
  box-shadow:0 10px 25px rgba(0,0,0,0.15);
  transition:0.3s;
}

.small img:hover{
  transform:scale(1.05);
}

/* TEXTO */
.lux-text h2{
  font-size:32px;
  letter-spacing:2px;
  font-weight:400;
  margin-bottom:15px;
}

.lux-text p{
  font-size:15px;
  color:#555;
  margin-bottom:25px;
  max-width:400px;
}

/* BOTÃO */
.btn{
  background:#111;
  color:#fff;
  padding:14px 28px;
  text-decoration:none;
  font-size:13px;
  letter-spacing:2px;
  display:inline-block;
  transition:0.3s;
}

.btn:hover{
  background:#2b0000;
}

/* ANIMAÇÃO */
@keyframes fade{
  from{
    opacity:0;
    transform:translateY(20px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

/* MOBILE */
@media(max-width:768px){
  .lux-wrapper{
    grid-template-columns:1fr;
    text-align:center;
  }
}

</style>

{% schema %}
{
  "name": "Best Seller Clean",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Imagem principal"
    },
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Imagem 1"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Imagem 2"
    },
    {
      "type": "image_picker",
      "id": "img3",
      "label": "Imagem 3"
    },
    {
      "type": "image_picker",
      "id": "img4",
      "label": "Imagem 4"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "BEST SELLERS | TOP 05"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Peças que deixam marca — nas fotos, na memória e na pele."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto do botão",
      "default": "EXPLORAR →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    }
  ],
  "presets": [
    {
      "name": "Best Seller Clean"
    }
  ]
}
{% endschema %}