<section class="motion-section">

  <div class="motion-container">

    <!-- PRINCIPAL -->
    <div class="main-img">
      {% if section.settings.main_image %}
        <img src="{{ section.settings.main_image | image_url: width: 800 }}">
      {% endif %}
    </div>

    <!-- LATERAIS -->
    <div class="side left-top">
      {% if section.settings.img1 %}
        <img src="{{ section.settings.img1 | image_url: width: 400 }}">
      {% endif %}
    </div>

    <div class="side right-top">
      {% if section.settings.img2 %}
        <img src="{{ section.settings.img2 | image_url: width: 400 }}">
      {% endif %}
    </div>

    <div class="side left-bottom">
      {% if section.settings.img3 %}
        <img src="{{ section.settings.img3 | image_url: width: 400 }}">
      {% endif %}
    </div>

    <div class="side right-bottom">
      {% if section.settings.img4 %}
        <img src="{{ section.settings.img4 | image_url: width: 400 }}">
      {% endif %}
    </div>

  </div>

  <div class="motion-text">
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.subtitle }}</p>
  </div>

</section>

<style>

.motion-section{
  background:#2b0000;
  padding:100px 20px;
  text-align:center;
  color:#fff;
}

/* CONTAINER */
.motion-container{
  position:relative;
  max-width:500px;
  margin:80px auto;
  overflow:visible;
}

/* PRINCIPAL */
.main-img{
  position:relative;
  z-index:1;
  animation:fadeMain 1s ease forwards;
}

.main-img img{
  width:240px;
  height:340px;
  object-fit:cover;
  border-radius:20px;
  display:block;
  margin:auto;
  box-shadow:0 30px 80px rgba(0,0,0,0.5);
}

/* LATERAIS (NA FRENTE E PRÓXIMAS) */
.side{
  position:absolute;
  z-index:999;
  opacity:0;
}

.side img{
  width:130px;
  height:180px;
  object-fit:cover;
  border-radius:15px;
  box-shadow:0 20px 50px rgba(0,0,0,0.35);
  transition:0.4s;
}

/* POSIÇÕES (COLADAS NA PRINCIPAL) */
.left-top{
  top:10px;
  left:-70px;
  animation:popLeftTop 0.8s ease forwards;
  animation-delay:0.3s;
}

.right-top{
  top:10px;
  right:-70px;
  animation:popRightTop 0.8s ease forwards;
  animation-delay:0.5s;
}

.left-bottom{
  bottom:10px;
  left:-80px;
  animation:popLeftBottom 0.8s ease forwards;
  animation-delay:0.7s;
}

.right-bottom{
  bottom:10px;
  right:-80px;
  animation:popRightBottom 0.8s ease forwards;
  animation-delay:0.9s;
}

/* HOVER PREMIUM */
.side img:hover{
  transform:scale(1.1) translateY(-5px);
}

/* ANIMAÇÃO PRINCIPAL */
@keyframes fadeMain{
  from{
    opacity:0;
    transform:scale(0.85);
  }
  to{
    opacity:1;
    transform:scale(1);
  }
}

/* EFEITO SAINDO DA PRINCIPAL */
@keyframes popLeftTop{
  from{
    opacity:0;
    transform:translate(80px,80px) scale(0.5);
    filter:blur(6px);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
    filter:blur(0);
  }
}

@keyframes popRightTop{
  from{
    opacity:0;
    transform:translate(-80px,80px) scale(0.5);
    filter:blur(6px);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
    filter:blur(0);
  }
}

@keyframes popLeftBottom{
  from{
    opacity:0;
    transform:translate(80px,-80px) scale(0.5);
    filter:blur(6px);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
    filter:blur(0);
  }
}

@keyframes popRightBottom{
  from{
    opacity:0;
    transform:translate(-80px,-80px) scale(0.5);
    filter:blur(6px);
  }
  to{
    opacity:1;
    transform:translate(0,0) scale(1);
    filter:blur(0);
  }
}

/* TEXTO */
.motion-text{
  margin-top:70px;
}

.motion-text h2{
  font-size:28px;
  letter-spacing:2px;
  margin-bottom:10px;
  font-weight:300;
}

.motion-text p{
  font-size:14px;
  opacity:0.8;
}

/* MOBILE */
@media(max-width:768px){

  .main-img img{
    width:200px;
    height:280px;
  }

  .side img{
    width:90px;
    height:130px;
  }

  .left-top{ left:-50px; }
  .right-top{ right:-50px; }
  .left-bottom{ left:-60px; }
  .right-bottom{ right:-60px; }

}

</style>

{% schema %}
{
  "name": "Best Seller Motion",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Imagem principal" },
    { "type": "image_picker", "id": "img1", "label": "Imagem 1 (esquerda topo)" },
    { "type": "image_picker", "id": "img2", "label": "Imagem 2 (direita topo)" },
    { "type": "image_picker", "id": "img3", "label": "Imagem 3 (esquerda baixo)" },
    { "type": "image_picker", "id": "img4", "label": "Imagem 4 (direita baixo)" },
    { "type": "text", "id": "title", "label": "Título", "default": "BEST SELLERS | TOP 05" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "As peças mais desejadas da coleção." }
  ],
  "presets": [
    { "name": "Best Seller Motion" }
  ]
}
{% endschema %}