<section class="home-zara">

<!-- TOPBAR -->
<div class="topbar">
  {{ section.settings.topbar }}
</div>

<!-- HERO -->
<div class="hero">

  <img 
    src="{{ section.settings.hero_desktop | image_url: width: 2000 }}" 
    class="hero-img desktop"
    alt="Banner">

  <img 
    src="{{ section.settings.hero_mobile | image_url: width: 1000 }}" 
    class="hero-img mobile"
    alt="Banner">

  <div class="overlay"></div>

  <div class="hero-text">
    <h1>{{ section.settings.title }}</h1>
    <a href="{{ section.settings.link }}">{{ section.settings.button }}</a>
  </div>

</div>

<!-- CATEGORIAS -->
<div class="categories">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}" class="item">
      <img src="{{ block.settings.img | image_url: width: 800 }}">
      <span>{{ block.settings.title }}</span>
    </a>
  {% endfor %}
</div>

</section>

<style>

/* BASE */
.home-zara{
  max-width:1300px;
  margin:auto;
  font-family: Helvetica, Arial, sans-serif;
}

/* TOPBAR */
.topbar{
  background:#000;
  color:#fff;
  text-align:center;
  font-size:11px;
  padding:8px;
  letter-spacing:2px;
}

/* HERO */
.hero{
  position:relative;
  height:80vh;
  overflow:hidden;
}

.hero-img{
  position:absolute;
  width:100%;
  height:100%;
  object-fit:cover;
  top:0;
  left:0;
}

.hero-img.mobile{
  display:none;
}

/* OVERLAY */
.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.25);
}

/* TEXTO */
.hero-text{
  position:absolute;
  bottom:60px;
  left:60px;
  color:#fff;
}

.hero-text h1{
  font-size:48px;
  font-weight:300;
}

.hero-text a{
  display:inline-block;
  margin-top:14px;
  font-size:12px;
  letter-spacing:2px;
  color:#fff;
  text-decoration:none;
  border-bottom:1px solid rgba(255,255,255,0.6);
}

/* CATEGORIAS */
.categories{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  padding:40px;
}

.item{
  text-decoration:none;
  color:#111;
}

.item img{
  width:100%;
  height:240px;
  object-fit:cover;
  border-radius:8px;
}

.item span{
  display:block;
  text-align:center;
  margin-top:10px;
  font-size:11px;
  letter-spacing:2px;
}

/* MOBILE */
@media(max-width:768px){

  .hero{
    height:55vh;
  }

  .hero-img.desktop{
    display:none;
  }

  .hero-img.mobile{
    display:block;
  }

  .hero-text{
    left:20px;
    bottom:25px;
  }

  .hero-text h1{
    font-size:26px;
  }

  .categories{
    grid-template-columns:repeat(2,1fr);
    padding:20px;
  }

}

</style>

{% schema %}
{
  "name": "Home Jade",
  "settings": [
    {
      "type": "text",
      "id": "topbar",
      "label": "Texto topo",
      "default": "Frete grátis • 6x sem juros • 15% OFF"
    },
    {
      "type": "image_picker",
      "id": "hero_desktop",
      "label": "Imagem Desktop"
    },
    {
      "type": "image_picker",
      "id": "hero_mobile",
      "label": "Imagem Mobile"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Seu momento. Sua essência."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Botão",
      "default": "Explorar coleção"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do botão"
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Jade"
    }
  ]
}
{% endschema %}