<section class="home-editorial">

  <!-- TOPBAR -->
  <div class="topbar">
    Frete grátis • 6x sem juros • 15% OFF em toda loja
  </div>

  <!-- HERO -->
  <div class="hero">
    <div class="overlay"></div>

    <div class="content">
      <h1>Mais do que lingerie.<br>Uma experiência.</h1>
      <p>Sinta-se desejada, confiante e poderosa.</p>
      <a href="/collections/all" class="btn">Explorar coleção</a>
    </div>
  </div>

  <!-- CATEGORIAS -->
  <div class="categories">
    <a href="/collections/all">
      <img src="https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03">
      <span>Conjuntos</span>
    </a>

    <a href="/collections/all">
      <img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990">
      <span>Body</span>
    </a>

    <a href="/collections/all">
      <img src="https://images.unsplash.com/photo-1593032465171-8f8c9dc6251d">
      <span>Camisolas</span>
    </a>
  </div>

  <!-- PRODUTOS -->
  <div class="products">
    <h2>Mais desejados</h2>

    <div class="grid">
      {% for product in collections.all.products limit: 4 %}
        <a href="{{ product.url }}" class="card">
          <img src="{{ product.featured_image | image_url: width: 600 }}">

          <p class="title">{{ product.title }}</p>

          <div class="price">
            {% if product.compare_at_price > product.price %}
              <span class="old">{{ product.compare_at_price | money }}</span>
            {% endif %}
            <span class="new">{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>

</section>

<style>

/* BASE */
.home-editorial {
  max-width: 1200px;
  margin: auto;
  font-family: Arial;
}

/* TOPBAR */
.topbar {
  background: #111;
  color: #fff;
  text-align: center;
  padding: 10px;
  font-size: 12px;
}

/* HERO */
.hero {
  height: 80vh;
  background: url('https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03') center/cover;
  position: relative;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
}

.content {
  position: absolute;
  bottom: 60px;
  left: 60px;
  color: #fff;
}

.content h1 {
  font-size: 40px;
  font-weight: 300;
}

.content p {
  margin: 10px 0 20px;
}

.btn {
  background: #8B1E3F;
  color: #fff;
  padding: 12px 25px;
  text-decoration: none;
}

/* CATEGORIAS */
.categories {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 10px;
  margin: 60px 0;
}

.categories img {
  width: 100%;
  height: 350px;
  object-fit: cover;
}

.categories span {
  position: absolute;
  bottom: 15px;
  left: 15px;
  color: white;
}

/* PRODUTOS */
.products h2 {
  text-align: center;
  margin-bottom: 30px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 20px;
}

.card img {
  width: 100%;
  height: 350px;
  object-fit: cover;
}

.title {
  font-size: 13px;
}

.price {
  font-size: 13px;
}

.old {
  text-decoration: line-through;
  color: #999;
}

.new {
  color: #8B1E3F;
}

/* MOBILE */
@media(max-width:768px){
  .grid {
    grid-template-columns: 1fr 1fr;
  }

  .categories {
    grid-template-columns: 1fr;
  }
}

</style>