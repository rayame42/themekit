<section class="home-luxo">

<!-- TOPO -->
<div class="topbar">
  Frete grátis + 6x sem juros • 15% OFF em toda loja
</div>

<!-- HERO -->
<div class="hero">
  <img src="{{ section.settings.hero }}">
  <div class="overlay"></div>

  <div class="hero-content">
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.subtitle }}</p>
    <a href="{{ section.settings.link }}" class="btn-primary">
      {{ section.settings.button }}
    </a>
  </div>
</div>

<!-- CATEGORIAS -->
<div class="categorias">
  {% for block in section.blocks %}
    {% if block.type == 'categoria' %}
      <a href="{{ block.settings.link }}" class="cat">
        <img src="{{ block.settings.img }}">
        <span>{{ block.settings.nome }}</span>
      </a>
    {% endif %}
  {% endfor %}
</div>

<!-- BEST SELLERS (NOVO LUXO) -->
<section class="best-luxo">

  <div class="best-left">
    <h2>BEST SELLERS</h2>
    <p>
      Essas são as peças que deixaram marca.<br>
      Na pele, na memória e na atitude.
    </p>
    <a href="/collections/all" class="btn-outline">Explorar coleção</a>
  </div>

  <div class="best-right">
    {% for product in collections['all'].products limit:3 %}
      <a href="{{ product.url }}" class="best-card">
        <img src="{{ product.featured_image | image_url: width: 800 }}">
        <div class="best-overlay">
          <span>{{ product.title }}</span>
          <small>{{ product.price | money }}</small>
        </div>
      </a>
    {% endfor %}
  </div>

</section>

<!-- PRODUTOS -->
<div class="produtos">
  <h2>Mais desejados</h2>

  <div class="grid">
    {% for product in collections['all'].products limit:4 %}
      <a href="{{ product.url }}" class="card">

        <div class="img">
          <img src="{{ product.featured_image | image_url: width: 500 }}">
          {% if product.compare_at_price > product.price %}
            <span class="badge">Promoção</span>
          {% endif %}
        </div>

        <h3>{{ product.title }}</h3>

        <div class="price">
          {% if product.compare_at_price > product.price %}
            <span class="old">{{ product.compare_at_price | money }}</span>
          {% endif %}
          <span class="new">{{ product.price | money }}</span>
        </div>

      </a>
    {% endfor %}
  </div>
</div>

<!-- AVALIAÇÕES (JUDGE.ME) -->
<div class="reviews">
  <h2>O que dizem sobre nós</h2>
  <div class="jdgm-carousel"></div>
</div>

<!-- NEWSLETTER -->
<div class="newsletter">
  <h2>Faça parte da nossa lista</h2>
  <p>Receba ofertas exclusivas</p>

  <form method="post" action="/contact#contact_form">
    <input type="email" name="contact[email]" placeholder="Seu e-mail">
    <button type="submit">Inscrever-se</button>
  </form>
</div>

<!-- ATENDIMENTO -->
<div class="faq">
  <h3>Atendimento ao Cliente</h3>
  <div>Envio e Frete</div>
  <div>Políticas de Reembolso</div>
  <div>Fale Conosco</div>
  <div>Sobre Nós</div>
</div>

</section>

<style>

/* TOPO */
.topbar{
  background:#000;
  color:#fff;
  text-align:center;
  padding:10px;
  font-size:12px;
  letter-spacing:1px;
}

/* HERO */
.hero{
  position:relative;
  height:90vh;
}

.hero img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.4);
}

.hero-content{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  text-align:center;
  color:#fff;
}

.hero h1{
  font-size:48px;
  font-weight:300;
}

.btn-primary{
  background:#8B1E3F;
  padding:14px 30px;
  color:#fff;
}

/* CATEGORIAS */
.categorias{
  display:grid;
  grid-template-columns:repeat(3,1fr);
}

.cat img{
  width:100%;
  height:400px;
  object-fit:cover;
}

.cat span{
  position:absolute;
  bottom:20px;
  left:20px;
  color:#fff;
}

/* BEST */
.best-luxo{
  display:grid;
  grid-template-columns:1fr 2fr;
  gap:60px;
  padding:100px 8%;
}

.best-card img{
  height:500px;
  object-fit:cover;
}

/* PRODUTOS */
.produtos{
  padding:80px 20px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:30px;
}

/* REVIEWS */
.reviews{
  padding:80px;
  text-align:center;
}

/* NEWS */
.newsletter{
  padding:80px;
  text-align:center;
}

/* FAQ */
.faq{
  padding:60px;
  background:#2b0000;
  color:#fff;
}

</style>

{% schema %}
{
  "name": "Home Luxo",
  "settings": [
    { "type": "image_picker", "id": "hero", "label": "Imagem Hero" },
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "text", "id": "button", "label": "Texto botão" },
    { "type": "url", "id": "link", "label": "Link botão" }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "text", "id": "nome", "label": "Nome" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Home Luxo" }
  ]
}
{% endschema %}