<section class="home-ultra">

<!-- TOPBAR -->
<div class="topbar">
{{ section.settings.top_text }}
</div>

<!-- HERO -->
<div class="hero" style="background-image: url({{ section.settings.hero_image | image_url }});">
  <div class="overlay"></div>

  <div class="hero-text">
    <span class="tag">{{ section.settings.hero_tag }}</span>
    <h1>{{ section.settings.hero_title }}</h1>
    <a href="{{ section.settings.hero_link }}">{{ section.settings.hero_button }}</a>
  </div>
</div>

<!-- CATEGORIAS -->
<div class="categories">

  <a href="{{ section.settings.cat1_link }}">
    <img src="{{ section.settings.cat1_img | image_url }}">
    <span>{{ section.settings.cat1_text }}</span>
  </a>

  <a href="{{ section.settings.cat2_link }}">
    <img src="{{ section.settings.cat2_img | image_url }}">
    <span>{{ section.settings.cat2_text }}</span>
  </a>

  <a href="{{ section.settings.cat3_link }}">
    <img src="{{ section.settings.cat3_img | image_url }}">
    <span>{{ section.settings.cat3_text }}</span>
  </a>

</div>

<!-- PRODUTOS -->
<div class="products">

{% for product in collections.all.products limit: 8 %}
<div class="card">

  <a href="{{ product.url }}">
    <img src="{{ product.featured_image | image_url: width: 600 }}">
  </a>

  <p class="title">{{ product.title }}</p>

  <div class="price">
    {% if product.compare_at_price > product.price %}
      <span class="old">{{ product.compare_at_price | money }}</span>
    {% endif %}
    <span class="new">{{ product.price | money }}</span>
  </div>

</div>
{% endfor %}

</div>

</section>

<style>
.topbar{background:#000;color:#fff;text-align:center;padding:8px;font-size:12px}
.hero{height:90vh;background-size:cover;background-position:center;position:relative}
.overlay{position:absolute;inset:0;background:rgba(0,0,0,0.3)}
.hero-text{position:absolute;bottom:60px;left:60px;color:#fff}
.hero-text h1{font-size:42px;font-weight:300}
.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:10px}
.categories img{width:100%}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:40px}
.old{text-decoration:line-through;color:#aaa}
.new{color:#8B1E3F}
</style>

{% schema %}
{
  "name": "Home Jade",
  "settings": [

    { "type": "text", "id": "top_text", "label": "Texto topo", "default": "Frete grátis • 6x sem juros • 15% OFF" },

    { "type": "image_picker", "id": "hero_image", "label": "Imagem Hero" },
    { "type": "text", "id": "hero_tag", "label": "Texto pequeno", "default": "Nova coleção" },
    { "type": "text", "id": "hero_title", "label": "Título", "default": "Elegância que se sente." },
    { "type": "text", "id": "hero_button", "label": "Botão", "default": "Explorar" },
    { "type": "url", "id": "hero_link", "label": "Link botão" },

    { "type": "image_picker", "id": "cat1_img", "label": "Imagem Categoria 1" },
    { "type": "text", "id": "cat1_text", "label": "Texto Categoria 1", "default": "Conjuntos" },
    { "type": "url", "id": "cat1_link", "label": "Link Categoria 1" },

    { "type": "image_picker", "id": "cat2_img", "label": "Imagem Categoria 2" },
    { "type": "text", "id": "cat2_text", "label": "Texto Categoria 2", "default": "Body" },
    { "type": "url", "id": "cat2_link", "label": "Link Categoria 2" },

    { "type": "image_picker", "id": "cat3_img", "label": "Imagem Categoria 3" },
    { "type": "text", "id": "cat3_text", "label": "Texto Categoria 3", "default": "Camisolas" },
    { "type": "url", "id": "cat3_link", "label": "Link Categoria 3" }

  ],
  "presets": [
    {
      "name": "Home Jade"
    }
  ]
}
{% endschema %}