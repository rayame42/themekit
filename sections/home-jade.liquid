<section class="product-luxo">

  <div class="wrap">

    <!-- GALERIA -->
    <div class="gallery">
      <div class="main-image">
        <img id="mainProductImage" src="{{ product.featured_image | image_url: width: 900 }}">
      </div>

      <div class="thumbs">
        {% for image in product.images %}
          <img src="{{ image | image_url: width: 300 }}" onclick="document.getElementById('mainProductImage').src=this.src">
        {% endfor %}
      </div>
    </div>

    <!-- INFO -->
    <div class="info">

      <h1>{{ product.title }}</h1>

      <!-- ⭐ AVALIAÇÕES JUDGE.ME -->
      <div class="reviews">
        <span class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}"></span>
      </div>

      <!-- PREÇO -->
      <div class="price">
        {% if product.compare_at_price > product.price %}
          <span class="old">{{ product.compare_at_price | money }}</span>
        {% endif %}
        <span class="new">{{ product.price | money }}</span>
      </div>

      <!-- DESCRIÇÃO LIMPA -->
      <div class="desc">
        {{ product.description }}
      </div>

      <!-- VARIANTES -->
      <form method="post" action="/cart/add" class="product-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <!-- CORES -->
        {% if product.options_with_values[0].name == 'Cor' %}
        <div class="option-group">
          <p>Cor</p>
          <div class="options">
            {% for value in product.options_with_values[0].values %}
              <button type="button" class="option-btn">{{ value }}</button>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- TAMANHOS -->
        {% if product.options_with_values[1].name == 'Tamanho' %}
        <div class="option-group">
          <p>Tamanho</p>
          <div class="options">
            {% for value in product.options_with_values[1].values %}
              <button type="button" class="option-btn">{{ value }}</button>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- BOTÕES -->
        <button type="submit" class="btn-main">
          Adicionar ao carrinho
        </button>

        <button type="submit" class="btn-buy">
          Comprar agora
        </button>

      </form>

      <!-- BENEFÍCIOS -->
      <div class="meta">
        <span>🔥 Últimas unidades</span>
        <span>✔ Frete grátis</span>
        <span>✔ 6x sem juros</span>
        <span>✔ Troca fácil</span>
      </div>

    </div>

  </div>

</section>

<style>
.product-luxo {
  max-width: 1200px;
  margin: auto;
  padding: 80px 20px;
}

/* GRID */
.wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
}

/* GALERIA */
.main-image img {
  width: 100%;
  border-radius: 8px;
}

.thumbs {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.thumbs img {
  width: 70px;
  height: 90px;
  object-fit: cover;
  cursor: pointer;
  opacity: 0.6;
  transition: 0.3s;
}

.thumbs img:hover {
  opacity: 1;
}

/* INFO */
.info h1 {
  font-size: 34px;
  font-weight: 400;
  line-height: 1.3;
  margin-bottom: 10px;
}

.reviews {
  margin-bottom: 15px;
}

/* PREÇO */
.price {
  margin: 20px 0;
}

.old {
  text-decoration: line-through;
  color: #aaa;
  margin-right: 10px;
}

.new {
  font-size: 22px;
  color: #8B1E3F;
}

/* DESCRIÇÃO */
.desc {
  font-size: 14px;
  line-height: 1.7;
  color: #444;
  margin-bottom: 30px;
}

/* VARIAÇÕES */
.option-group {
  margin-bottom: 20px;
}

.option-group p {
  font-size: 13px;
  margin-bottom: 8px;
}

.options {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.option-btn {
  padding: 8px 14px;
  border: 1px solid #ccc;
  background: #fff;
  cursor: pointer;
  border-radius: 6px;
  transition: 0.3s;
}

.option-btn:hover {
  border-color: #8B1E3F;
}

/* BOTÕES */
.btn-main {
  width: 100%;
  background: #8B1E3F;
  color: #fff;
  padding: 16px;
  border: none;
  margin-top: 10px;
  cursor: pointer;
  border-radius: 6px;
}

.btn-buy {
  width: 100%;
  background: transparent;
  border: 1px solid #8B1E3F;
  color: #8B1E3F;
  padding: 14px;
  margin-top: 10px;
  cursor: pointer;
  border-radius: 6px;
}

/* META */
.meta {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  color: #777;
}

/* MOBILE */
@media(max-width:768px){
  .wrap {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}
</style>