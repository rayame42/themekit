<section class="home-premium">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Mais do que lingerie.<br>Uma experiência.</h1>
      <p>Sinta-se desejada, confiante e poderosa — todos os dias.</p>
      <a href="/collections/all" class="btn-primary">Descobrir coleção</a>
    </div>
  </div>

  <!-- CATEGORIAS -->
  <div class="categories">
    <a href="/collections/all">
      <img src="https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03">
      <span>Conjuntos</span>
    </a>
    <a href="/collections/all">
      <img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990">
      <span>Body</span>
    </a>
    <a href="/collections/all">
      <img src="https://images.unsplash.com/photo-1593032465171-8f8c9dc6251d">
      <span>Camisolas</span>
    </a>
  </div>

  <!-- DESTAQUES -->
  <div class="featured">
    <h2>Mais desejados</h2>

    <div class="products">
      {% for product in collections.all.products limit: 4 %}
        <a href="{{ product.url }}" class="product-card">
          <img src="{{ product.featured_image | image_url: width: 500 }}">
          <div class="info">
            <p>{{ product.title }}</p>
            <span>{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>

  <!-- BANNER -->
  <div class="banner">
    <h2>Frete grátis + 6x sem juros</h2>
  </div>

</section>

<style>
.home-premium {
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

/* HERO */
.hero {
  height: 85vh;
  background: url('https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03') center/cover;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.4);
}

.hero-content {
  position: relative;
  text-align: center;
  color: #fff;
  max-width: 600px;
}

.hero h1 {
  font-size: 48px;
  font-weight: 400;
  margin-bottom: 15px;
}

.hero p {
  font-size: 16px;
  margin-bottom: 25px;
}

.btn-primary {
  background: #8B1E3F;
  color: #fff;
  padding: 14px 28px;
  text-decoration: none;
  border-radius: 6px;
  transition: 0.3s;
}

.btn-primary:hover {
  background: #6f1832;
}

/* CATEGORIAS */
.categories {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  padding: 60px 20px;
}

.categories a {
  position: relative;
  display: block;
}

.categories img {
  width: 100%;
  height: 300px;
  object-fit: cover;
}

.categories span {
  position: absolute;
  bottom: 15px;
  left: 15px;
  color: #fff;
  font-size: 18px;
}

/* PRODUTOS */
.featured {
  padding: 60px 20px;
  text-align: center;
}

.featured h2 {
  font-size: 28px;
  margin-bottom: 30px;
}

.products {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.product-card img {
  width: 100%;
}

.product-card .info {
  margin-top: 10px;
}

.product-card p {
  font-size: 14px;
}

.product-card span {
  color: #8B1E3F;
}

/* BANNER */
.banner {
  background: #8B1E3F;
  color: #fff;
  text-align: center;
  padding: 30px;
  margin-top: 40px;
}

/* MOBILE */
@media(max-width:768px){
  .hero h1 { font-size: 28px; }
  .categories { grid-template-columns: 1fr; }
  .products { grid-template-columns: 1fr 1fr; }
}
</style>