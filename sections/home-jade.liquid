<section class="home">

  <!-- TOPBAR -->
  <div class="topbar">
    {{ section.settings.topbar }}
  </div>

  <!-- HERO -->
  <div class="hero" style="background-image:url({{ section.settings.hero_image | image_url: width: 2000 }})">
    <div class="overlay"></div>

    <div class="content">
      <h1>{{ section.settings.title }}</h1>
      <p>{{ section.settings.subtitle }}</p>
      <a href="{{ section.settings.link }}" class="btn">
        {{ section.settings.button }}
      </a>
    </div>
  </div>

  <!-- CATEGORIAS -->
  <div class="categories">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cat">
        <img src="{{ block.settings.image | image_url: width: 800 }}">
        <span>{{ block.settings.title }}</span>
      </a>
    {% endfor %}
  </div>

  <!-- PRODUTOS -->
  <div class="products">
    <h2>{{ section.settings.products_title }}</h2>

    <div class="grid">
      {% for product in collections[section.settings.collection].products limit: 4 %}
        <a href="{{ product.url }}" class="card">
          <img src="{{ product.featured_image | image_url: width: 600 }}">

          <p class="title">{{ product.title }}</p>

          <div class="price">
            {% if product.compare_at_price > product.price %}
              <span class="old">{{ product.compare_at_price | money }}</span>
            {% endif %}
            <span class="new">{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>

</section>

<style>

.home { max-width:1200px; margin:auto; font-family:Arial; }

/* TOPBAR */
.topbar{
  background:#111;
  color:#fff;
  text-align:center;
  padding:10px;
  font-size:12px;
}

/* HERO */
.hero{
  height:80vh;
  background-size:cover;
  background-position:center;
  position:relative;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.4);
}

.content{
  position:absolute;
  bottom:60px;
  left:60px;
  color:#fff;
}

.content h1{ font-size:40px; font-weight:300; }
.content p{ margin:10px 0 20px; }

.btn{
  background:#8B1E3F;
  color:#fff;
  padding:12px 25px;
  text-decoration:none;
}

/* CATEGORIAS */
.categories{
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:10px;
  margin:60px 0;
}

.cat{
  position:relative;
}

.cat img{
  width:100%;
  height:350px;
  object-fit:cover;
}

.cat span{
  position:absolute;
  bottom:15px;
  left:15px;
  color:white;
}

/* PRODUTOS */
.products h2{
  text-align:center;
  margin-bottom:30px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

.card img{
  width:100%;
  height:350px;
  object-fit:cover;
}

.title{ font-size:13px; }

.price{ font-size:13px; }

.old{
  text-decoration:line-through;
  color:#999;
}

.new{
  color:#8B1E3F;
}

/* MOBILE */
@media(max-width:768px){
  .grid{ grid-template-columns:1fr 1fr; }
  .categories{ grid-template-columns:1fr; }
}

</style>

{% schema %}
{
  "name": "Home Premium",
  "settings": [
    { "type": "text", "id": "topbar", "label": "Texto topo", "default": "Frete grátis • 6x sem juros • 15% OFF" },
    { "type": "image_picker", "id": "hero_image", "label": "Imagem principal" },
    { "type": "text", "id": "title", "label": "Título", "default": "Mais do que lingerie. Uma experiência." },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Sinta-se desejada, confiante e poderosa." },
    { "type": "text", "id": "button", "label": "Texto botão", "default": "Explorar coleção" },
    { "type": "url", "id": "link", "label": "Link botão" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "text", "id": "products_title", "label": "Título produtos", "default": "Mais desejados" }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    { "name": "Home Premium" }
  ]
}
{% endschema %}