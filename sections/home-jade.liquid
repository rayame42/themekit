<!-- BEST SELLERS PREMIUM -->
<section class="best-luxo">

  <div class="best-left">
    <h2>BEST SELLERS</h2>
    <p>
      Essas são as peças que deixaram marca.<br>
      Na pele, na memória e na atitude.
    </p>

    <a href="/collections/all" class="btn-outline">
      Explorar coleção
    </a>
  </div>

  <div class="best-right">
    {% for product in collections['all'].products limit:3 %}
      <a href="{{ product.url }}" class="best-card">
        <img src="{{ product.featured_image | image_url: width: 800 }}">
        <div class="best-overlay">
          <span>{{ product.title }}</span>
          <small>{{ product.price | money }}</small>
        </div>
      </a>
    {% endfor %}
  </div>

</section>

<!-- PRODUTOS PREMIUM -->
<section class="prod-luxo">

  <h2>Mais desejados</h2>

  <div class="prod-grid">
    {% for product in collections['all'].products limit:4 %}
      <a href="{{ product.url }}" class="prod-card">

        <div class="prod-img">
          <img src="{{ product.featured_image | image_url: width: 600 }}">
        </div>

        <div class="prod-info">
          <h3>{{ product.title }}</h3>

          <div class="price">
            {% if product.compare_at_price > product.price %}
              <span class="old">{{ product.compare_at_price | money }}</span>
            {% endif %}
            <span class="new">{{ product.price | money }}</span>
          </div>

        </div>

      </a>
    {% endfor %}
  </div>

</section>

<style>

/* BEST SELLERS */
.best-luxo{
  display:grid;
  grid-template-columns: 1fr 2fr;
  gap:60px;
  padding:120px 8%;
  align-items:center;
}

.best-left h2{
  font-size:36px;
  font-weight:300;
  margin-bottom:20px;
}

.best-left p{
  color:#666;
  line-height:1.6;
  margin-bottom:25px;
}

.btn-outline{
  border:1px solid #000;
  padding:12px 24px;
  text-decoration:none;
  color:#000;
}

.best-right{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.best-card{
  position:relative;
  overflow:hidden;
}

.best-card img{
  width:100%;
  height:500px;
  object-fit:cover;
  transition:0.4s;
}

.best-card:hover img{
  transform:scale(1.05);
}

.best-overlay{
  position:absolute;
  bottom:20px;
  left:20px;
  color:#fff;
}

/* PRODUTOS */
.prod-luxo{
  padding:100px 8%;
}

.prod-luxo h2{
  text-align:center;
  font-weight:300;
  margin-bottom:60px;
}

.prod-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:40px;
}

.prod-card img{
  width:100%;
  transition:0.3s;
}

.prod-card:hover img{
  opacity:0.85;
}

.prod-info{
  margin-top:10px;
}

.prod-info h3{
  font-size:14px;
  font-weight:400;
}

.price{
  margin-top:5px;
}

.old{
  text-decoration:line-through;
  color:#999;
  margin-right:8px;
}

.new{
  color:#8B1E3F;
  font-weight:500;
}

</style>