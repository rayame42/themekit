<section class="home-zara">

<!-- TOPBAR -->
<div class="topbar">
  {{ section.settings.topbar }}
</div>

<!-- HERO -->
<div class="hero" style="background-image:url({{ section.settings.hero | image_url: width: 2000 }});">
  <div class="overlay"></div>

  <div class="hero-text">
    <h1>{{ section.settings.title }}</h1>
    <a href="{{ section.settings.link }}">{{ section.settings.button }}</a>
  </div>
</div>

<!-- CATEGORIAS -->
<div class="categories">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}">
      <img src="{{ block.settings.img | image_url: width: 800 }}">
      <span>{{ block.settings.title }}</span>
    </a>
  {% endfor %}
</div>

<!-- 🔥 BEST SELLER MOTION -->
<div class="motion-section">

  <div class="motion-container">

    <div class="main-img">
      <img src="{{ section.settings.main_image | image_url: width: 900 }}">
    </div>

    <div class="side img1">
      <img src="{{ section.settings.img1 | image_url: width: 500 }}">
    </div>

    <div class="side img2">
      <img src="{{ section.settings.img2 | image_url: width: 500 }}">
    </div>

    <div class="side img3">
      <img src="{{ section.settings.img3 | image_url: width: 500 }}">
    </div>

    <div class="side img4">
      <img src="{{ section.settings.img4 | image_url: width: 500 }}">
    </div>

  </div>

  <div class="motion-text">
    <h2>{{ section.settings.motion_title }}</h2>
    <p>{{ section.settings.motion_subtitle }}</p>
  </div>

</div>

<!-- PRODUTOS -->
<div class="products">
  {% assign selected_collection = collections[section.settings.collection] %}

  {% if selected_collection != blank %}
    {% for product in selected_collection.products limit: 8 %}
      <div class="card">

        <a href="{{ product.url }}" class="image-wrapper">

          <img class="img1" src="{{ product.featured_image | image_url: width: 600 }}">

          {% if product.images.size > 1 %}
            <img class="img2" src="{{ product.images[1] | image_url: width: 600 }}">
          {% endif %}

        </a>

        <p class="title">{{ product.title }}</p>

        <div class="price">
          {% if product.compare_at_price > product.price %}
            <span class="old">{{ product.compare_at_price | money }}</span>
          {% endif %}
          <span class="new">{{ product.price | money }}</span>
        </div>

      </div>
    {% endfor %}
  {% endif %}
</div>

</section>

<style>

.home-zara{
  max-width:1200px;
  margin:auto;
  font-family: Helvetica, Arial, sans-serif;
}

/* TOPBAR */
.topbar{
  background:#000;
  color:#fff;
  text-align:center;
  font-size:11px;
  padding:8px;
  letter-spacing:2px;
}

/* HERO */
.hero{
  height:80vh;
  background-size:cover;
  background-position:center;
  position:relative;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.25);
}

.hero-text{
  position:absolute;
  bottom:60px;
  left:60px;
  color:#fff;
}

.hero-text h1{
  font-size:46px;
  font-weight:300;
}

.hero-text a{
  display:inline-block;
  margin-top:12px;
  font-size:12px;
  letter-spacing:1.5px;
  text-transform:uppercase;
  color:#fff;
  text-decoration:none;
  border-bottom:1px solid rgba(255,255,255,0.6);
  padding-bottom:4px;
}

/* CATEGORIAS */
.categories{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  padding:30px 40px;
}

.categories img{
  width:100%;
  height:220px;
  object-fit:cover;
}

.categories span{
  display:block;
  text-align:center;
  font-size:11px;
  margin-top:8px;
  letter-spacing:2px;
}

/* 🔥 MOTION */
.motion-section{
  background:#2b0000;
  padding:80px 20px;
  text-align:center;
  color:#fff;
}

.motion-section{
  background:#2b0000;
  padding:80px 20px;
  text-align:center;
  color:#fff;
  overflow:hidden;
}

.motion-container{
  position:relative;
  max-width:700px;
  margin:auto;
}

/* IMAGEM PRINCIPAL */
.main-img img{
  width:100%;
  height:420px;
  object-fit:cover;
  border-radius:20px;
  z-index:2;
  position:relative;
}

/* IMAGENS LATERAIS */
.side{
  position:absolute;
  z-index:1;
  animation:float 4s ease-in-out infinite;
}

.side img{
  width:140px;
  height:180px;
  object-fit:cover;
  border-radius:15px;
  opacity:0.9;
}

/* POSIÇÕES */
.img1{ top:20px; left:-60px; }
.img2{ top:20px; right:-60px; }
.img3{ bottom:20px; left:-60px; }
.img4{ bottom:20px; right:-60px; }

/* ANIMAÇÃO SUAVE */
@keyframes float{
  0%{ transform:translateY(0);}
  50%{ transform:translateY(-12px);}
  100%{ transform:translateY(0);}
}

/* TEXTO */
.motion-text{
  margin-top:60px;
}

.motion-text h2{
  font-size:26px;
  letter-spacing:2px;
  font-weight:300;
}

.motion-text p{
  font-size:14px;
  opacity:0.8;
}

/* MOBILE */
@media(max-width:768px){
  .motion-container{
    max-width:100%;
  }

  .main-img img{
    height:320px;
  }

  .side{
    display:none;
  }
}

.img1{ top:0; left:-100px; animation:show1 1s ease forwards 0.5s; }
.img2{ top:0; right:-100px; animation:show2 1s ease forwards 0.8s; }
.img3{ bottom:0; left:-100px; animation:show3 1s ease forwards 1.1s; }
.img4{ bottom:0; right:-100px; animation:show4 1s ease forwards 1.4s; }

@keyframes fadeMain{
  from{opacity:0; transform:scale(0.95);}
  to{opacity:1; transform:scale(1);}
}

@keyframes show1{
  from{opacity:0; transform:translate(-40px,40px);}
  to{opacity:1; transform:translate(0,0);}
}

@keyframes show2{
  from{opacity:0; transform:translate(40px,40px);}
  to{opacity:1; transform:translate(0,0);}
}

@keyframes show3{
  from{opacity:0; transform:translate(-40px,-40px);}
  to{opacity:1; transform:translate(0,0);}
}

@keyframes show4{
  from{opacity:0; transform:translate(40px,-40px);}
  to{opacity:1; transform:translate(0,0);}
}

.motion-text{
  margin-top:60px;
}

.motion-text h2{
  font-size:28px;
  letter-spacing:2px;
}

.motion-text p{
  font-size:14px;
  opacity:0.8;
}

/* PRODUTOS */
.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  padding:40px;
}

.card img{
  width:100%;
  height:300px;
  object-fit:cover;
}

/* MOBILE */
@media(max-width:768px){
  .products{
    grid-template-columns:repeat(2,1fr);
  }

  .categories{
    grid-template-columns:repeat(2,1fr);
  }
}

</style>

{% schema %}
{
  "name": "Home Jade",
  "settings": [
    { "type": "text", "id": "topbar", "label": "Texto topo", "default": "Frete grátis • 6x sem juros • 15% OFF" },
    { "type": "image_picker", "id": "hero", "label": "Imagem Hero" },
    { "type": "text", "id": "title", "label": "Título", "default": "Seu momento. Sua essência." },
    { "type": "text", "id": "button", "label": "Botão", "default": "Explorar coleção" },
    { "type": "url", "id": "link", "label": "Link botão" },

    { "type": "image_picker", "id": "main_image", "label": "Imagem principal motion" },
    { "type": "image_picker", "id": "img1", "label": "Imagem 1" },
    { "type": "image_picker", "id": "img2", "label": "Imagem 2" },
    { "type": "image_picker", "id": "img3", "label": "Imagem 3" },
    { "type": "image_picker", "id": "img4", "label": "Imagem 4" },

    { "type": "text", "id": "motion_title", "label": "Título motion", "default": "BEST SELLERS | TOP 05" },
    { "type": "text", "id": "motion_subtitle", "label": "Subtítulo", "default": "Essas são as peças que deixaram marca." }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Home Jade"
    }
  ]
}
{% endschema %}