<section class="home-zara">

<!-- TOPBAR -->
<div class="topbar">
  {{ section.settings.topbar }}
</div>

<!-- HERO -->
<div class="hero" style="background-image:url({{ section.settings.hero | image_url: width: 2000 }});">
  <div class="overlay"></div>

  <div class="hero-text">
    <h1>{{ section.settings.title }}</h1>
    <a href="{{ section.settings.link }}">{{ section.settings.button }}</a>
  </div>
</div>

<!-- CATEGORIAS -->
<div class="categories">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}">
      <img src="{{ block.settings.img | image_url: width: 800 }}">
      <span>{{ block.settings.title }}</span>
    </a>
  {% endfor %}
</div>

</section>

<style>

/* ===== BASE ===== */
.home-zara{
  max-width:1200px;
  margin:auto;
  font-family: Helvetica, Arial, sans-serif;
}

/* TOPBAR */
.topbar{
  background:#000;
  color:#fff;
  text-align:center;
  font-size:11px;
  padding:8px;
  letter-spacing:2px;
}

/* HERO */
.hero{
  height:80vh;
  background-size:cover;
  background-position:center;
  position:relative;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.25);
}

.hero-text{
  position:absolute;
  bottom:60px;
  left:60px;
  color:#fff;
}

.hero-text h1{
  font-size:46px;
  font-weight:300;
}

.hero-text a{
  display:inline-block;
  margin-top:12px;
  font-size:12px;
  letter-spacing:1.5px;
  text-transform:uppercase;
  color:#fff;
  text-decoration:none;
  border-bottom:1px solid rgba(255,255,255,0.6);
}

/* CATEGORIAS */
.categories{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  padding:30px 40px;
}

.categories img{
  width:100%;
  height:220px;
  object-fit:cover;
}

.categories span{
  display:block;
  text-align:center;
  font-size:11px;
  margin-top:8px;
  letter-spacing:2px;
  color:#111;
}

/* REMOVE AZUL */
.categories a{
  text-decoration:none;
  color:#111;
}

.categories a:hover{
  color:#8B1E3F;
}

/* MOBILE */
@media(max-width:768px){
  .categories{
    grid-template-columns:repeat(2,1fr);
    padding:20px;
  }

  .hero-text{
    left:20px;
    bottom:20px;
  }

  .hero-text h1{
    font-size:28px;
  }
}

</style>

{% schema %}
{
  "name": "Home Jade",
  "settings": [
    { "type": "text", "id": "topbar", "label": "Texto topo", "default": "Frete grátis • 6x sem juros • 15% OFF" },
    { "type": "image_picker", "id": "hero", "label": "Imagem Hero" },
    { "type": "text", "id": "title", "label": "Título", "default": "Seu momento. Sua essência." },
    { "type": "text", "id": "button", "label": "Botão", "default": "Explorar coleção" },
    { "type": "url", "id": "link", "label": "Link botão" }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Jade"
    }
  ]
}
{% endschema %}