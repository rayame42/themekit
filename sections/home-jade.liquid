<section class="home-zara">

<!-- TOPBAR -->
<div class="topbar">
  {{ section.settings.topbar }}
</div>

<!-- HERO -->
.hero{
  min-height:calc(100vh - 80px);
}
  <!-- DESKTOP -->
  <img 
    src="{{ section.settings.hero_desktop | image_url: width: 2000 }}" 
    class="hero-img desktop"
    alt="Banner desktop">

  <!-- MOBILE -->
  <img 
    src="{{ section.settings.hero_mobile | image_url: width: 1000 }}" 
    class="hero-img mobile"
    alt="Banner mobile">

  <div class="overlay"></div>

  <div class="hero-text">
    <h1>{{ section.settings.title }}</h1>
    <a href="{{ section.settings.link }}">{{ section.settings.button }}</a>
  </div>

</div>

<!-- CATEGORIAS -->
<div class="categories-wrapper">

  <div class="arrow left" onclick="slideCategories(-1)">‹</div>
  <div class="arrow right" onclick="slideCategories(1)">›</div>

  <div class="categories">
      </div>
</div>

</section>

<style>

/* ===== BASE ===== */
.home-zara{
  max-width:1300px;
  margin:auto;
  font-family: Helvetica, Arial, sans-serif;
}

/* TOPBAR */
.topbar{
  background:#000;
  color:#fff;
  text-align:center;
  font-size:11px;
  padding:8px;
  letter-spacing:2px;
}

/* HERO */
.hero{
  position:relative;
  height:85vh;
  overflow:hidden;
}

/* IMAGENS */
.hero-img{
  position:absolute;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  top:0;
  left:0;
}

.hero-img.mobile{
  display:none;
}

/* OVERLAY */
.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.25);
}

/* TEXTO */
.hero-text{
  position:absolute;
  bottom:60px;
  left:60px;
  color:#fff;
  max-width:420px;
}

.hero-text h1{
  font-size:48px;
  font-weight:300;
  line-height:1.2;
}

.hero-text a{
  display:inline-block;
  margin-top:14px;
  font-size:12px;
  letter-spacing:2px;
  text-transform:uppercase;
  color:#fff;
  text-decoration:none;
  border-bottom:1px solid rgba(255,255,255,0.6);
  transition:0.3s;
}

.hero-text a:hover{
  opacity:0.7;
}

/* CATEGORIAS */
.categories{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  padding:40px;
}

.categories img{
  width:100%;
  height:240px;
  object-fit:cover;
  border-radius:6px;
  transition:0.3s;
}

.categories img:hover{
  transform:scale(1.03);
}

.categories span{
  display:block;
  text-align:center;
  font-size:11px;
  margin-top:10px;
  letter-spacing:2px;
  color:#111;
}

.categories a{
  text-decoration:none;
  color:#111;
}

/* ===== MOBILE AJUSTADO ===== */
@media(max-width:768px){

  .hero{
    height:55vh; /* 🔥 DIMINUIU O TAMANHO */
  }

  .hero-img.desktop{
    display:none;
  }

  .hero-img.mobile{
    display:block;
  }

  .hero-img{
    object-position:center top; /* 🔥 MELHOR ENQUADRAMENTO */
  }

  .hero-text{
    left:20px;
    bottom:25px;
    max-width:260px;
  }

  .hero-text h1{
    font-size:28px;
  }

  .categories{
    grid-template-columns:repeat(2,1fr);
    padding:20px;
  }

}

</style>

{% schema %}
{
  "name": "Home Jade",
  "settings": [
    { "type": "text", "id": "topbar", "label": "Texto topo", "default": "Frete grátis • 6x sem juros • 15% OFF" },

    { "type": "image_picker", "id": "hero_desktop", "label": "Imagem Hero Desktop" },
    { "type": "image_picker", "id": "hero_mobile", "label": "Imagem Hero Mobile" },

    { "type": "text", "id": "title", "label": "Título", "default": "Seu momento. Sua essência." },
    { "type": "text", "id": "button", "label": "Botão", "default": "Explorar coleção" },
    { "type": "url", "id": "link", "label": "Link botão" }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Jade"
    }
  ]
}
{% endschema %}