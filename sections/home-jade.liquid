<section class="home-premium">

<!-- TOPO -->
<div class="topbar">
Frete grátis • 6x sem juros • 15% OFF em toda loja
</div>

<!-- HERO -->
<div class="hero">
  <div class="overlay"></div>
  <div class="content">
    <h1>Mais do que lingerie.<br>Uma experiência.</h1>
    <p>Sinta-se desejada, confiante e poderosa — todos os dias.</p>
    <a href="/collections/all" class="btn">Descobrir coleção</a>
  </div>
</div>

<!-- CATEGORIAS -->
<div class="categories">
  <a href="/collections/conjuntos">
    <img src="https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03">
    <span>Conjuntos</span>
  </a>

  <a href="/collections/body">
    <img src="https://images.unsplash.com/photo-1618354691373-d851c5c3a990">
    <span>Body</span>
  </a>

  <a href="/collections/camisolas">
    <img src="https://images.unsplash.com/photo-1593032465171-8f8c9dc6251d">
    <span>Camisolas</span>
  </a>
</div>

<!-- PRODUTOS -->
<div class="products-section">
  <h2>Favoritos da coleção</h2>

  <div class="products">
    {% for product in collections.all.products limit: 4 %}
    <div class="card">
      <a href="{{ product.url }}">
        <img src="{{ product.featured_image | image_url: width: 500 }}">
      </a>

      <p class="title">{{ product.title }}</p>

      <div class="price">
        {% if product.compare_at_price > product.price %}
          <span class="old">{{ product.compare_at_price | money }}</span>
        {% endif %}
        <span class="new">{{ product.price | money }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

</section>

<style>

/* TOPBAR */
.topbar{
  background:#000;
  color:#fff;
  text-align:center;
  padding:10px;
  font-size:12px;
  letter-spacing:1px;
}

/* HERO */
.hero{
  height:80vh;
  background:url('https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03') center/cover;
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.4);
}

.content{
  position:relative;
  color:#fff;
  text-align:center;
}

.content h1{
  font-size:48px;
  font-weight:300;
}

.btn{
  margin-top:20px;
  display:inline-block;
  padding:12px 28px;
  border:1px solid #fff;
  color:#fff;
}

/* CATEGORIAS */
.categories{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  padding:60px;
}

.categories img{
  width:100%;
}

.categories span{
  display:block;
  margin-top:10px;
  text-align:center;
}

/* PRODUTOS */
.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:30px;
  padding:60px;
}

.card img{
  width:100%;
}

.title{
  font-size:14px;
}

.old{
  text-decoration:line-through;
  color:#aaa;
}

.new{
  color:#8B1E3F;
}

</style>