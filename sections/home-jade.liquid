/* =========================
   CONTAINER CENTRAL (PADRÃO ZARA)
========================= */

.page-width,
.main-content,
.home-luxo {
  max-width: 1200px !important;
  margin: 0 auto !important;
  padding-left: 20px !important;
  padding-right: 20px !important;
}

/* =========================
   HERO AJUSTADO
========================= */

.hero {
  height: 75vh !important;
}

.hero-content {
  max-width: 600px;
}

/* =========================
   CATEGORIAS AJUSTADAS
========================= */

.categorias {
  max-width: 1200px;
  margin: 60px auto;
  gap: 20px;
}

.cat img {
  height: 320px !important;
}

/* =========================
   BEST SELLERS ARRUMADO
========================= */

.best-luxo {
  max-width: 1200px;
  margin: 100px auto;
  gap: 40px;
}

.best-right {
  gap: 15px;
}

.best-card img {
  height: 380px !important;
}

/* =========================
   PRODUTOS (O MAIS IMPORTANTE)
========================= */

.produtos {
  max-width: 1200px;
  margin: 100px auto;
  padding: 0 !important;
}

.grid {
  grid-template-columns: repeat(4, 1fr);
  gap: 25px !important;
}

.card img {
  height: 320px;
  object-fit: cover;
}

/* =========================
   TEXTOS MAIS ELEGANTES
========================= */

h1 {
  font-size: 42px !important;
}

h2 {
  font-size: 26px !important;
  font-weight: 300;
  letter-spacing: 1px;
}

h3 {
  font-size: 13px;
}

/* =========================
   NEWSLETTER CENTRALIZADA
========================= */

.newsletter {
  max-width: 700px;
  margin: 100px auto;
}

/* =========================
   RESPONSIVO (IMPORTANTE)
========================= */

@media(max-width: 768px){

  .grid {
    grid-template-columns: repeat(2,1fr);
  }

  .categorias {
    grid-template-columns: 1fr;
  }

  .best-luxo {
    grid-template-columns: 1fr;
  }

}