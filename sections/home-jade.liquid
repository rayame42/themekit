<section class="home-zara">

<!-- TOPBAR -->
<div class="topbar">
  {{ section.settings.topbar }}
</div>

<!-- HERO -->
<div class="hero" style="background-image:url({{ section.settings.hero | image_url: width: 2000 }});">
  <div class="overlay"></div>

  <div class="hero-text">
    <h1>{{ section.settings.title }}</h1>
    <a href="{{ section.settings.link }}">{{ section.settings.button }}</a>
  </div>
</div>

<!-- CATEGORIAS -->
<div class="categories">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}">
      <img src="{{ block.settings.img | image_url: width: 800 }}">
      <span>{{ block.settings.title }}</span>
    </a>
  {% endfor %}
</div>

<!-- PRODUTOS -->
<div class="products">
  {% for product in collections[section.settings.collection].products limit: 8 %}
    <div class="card">

      <a href="{{ product.url }}" class="image-wrapper">

        <img class="img1" src="{{ product.featured_image | image_url: width: 600 }}">

        {% if product.images.size > 1 %}
          <img class="img2" src="{{ product.images[1] | image_url: width: 600 }}">
        {% endif %}

      </a>

      <p class="title">{{ product.title }}</p>

      <div class="price">
        {% if product.compare_at_price > product.price %}
          <span class="old">{{ product.compare_at_price | money }}</span>
        {% endif %}
        <span class="new">{{ product.price | money }}</span>
      </div>

    </div>
  {% endfor %}
</div>

</section>

<style>

.home-zara{
  max-width:1200px;
  margin:auto;
  font-family: Helvetica, Arial, sans-serif;
}

/* TOPBAR */
.topbar{
  background:#000;
  color:#fff;
  text-align:center;
  font-size:11px;
  padding:8px;
  letter-spacing:2px;
}

/* HERO */
.hero{
  height:80vh;
  background-size:cover;
  background-position:center;
  position:relative;
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.25);
}

.hero-text{
  position:absolute;
  bottom:60px;
  left:60px;
  color:#fff;
}

.hero-text h1{
  font-size:46px;
  font-weight:300;
}

.hero-text a{
  display:inline-block;
  margin-top:10px;
  border-bottom:1px solid #fff;
  font-size:13px;
}

/* CATEGORIAS */
.categories{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  padding:10px;
}

.categories img{
  width:100%;
  height:280px;
  object-fit:cover;
}

.categories span{
  display:block;
  text-align:center;
  font-size:12px;
  margin-top:5px;
}

/* PRODUTOS */
.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  padding:40px;
}

.card img{
  width:100%;
  height:300px;
  object-fit:cover;
}

.image-wrapper{
  position:relative;
  display:block;
}

.img2{
  position:absolute;
  inset:0;
  opacity:0;
}

.image-wrapper:hover .img2{
  opacity:1;
}

.image-wrapper:hover .img1{
  opacity:0;
}

.title{
  font-size:12px;
  margin-top:10px;
}

.price{
  font-size:13px;
}

.old{
  text-decoration:line-through;
  color:#aaa;
}

.new{
  color:#8B1E3F;
}

/* MOBILE */
@media(max-width:768px){
  .products{
    grid-template-columns:repeat(2,1fr);
  }

  .categories{
    grid-template-columns:1fr;
  }

  .hero-text{
    left:20px;
    bottom:20px;
  }

  .hero-text h1{
    font-size:28px;
  }
}

</style>

{% schema %}
{
  "name": "Home Zara",
  "settings": [
    {
      "type": "text",
      "id": "topbar",
      "label": "Texto topo",
      "default": "Frete grátis • 6x sem juros • 15% OFF"
    },
    {
      "type": "image_picker",
      "id": "hero",
      "label": "Imagem do Hero"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "NOVA COLEÇÃO"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Texto do botão",
      "default": "COMPRAR"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link botão"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção de produtos"
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Home Zara"
    }
  ]
}
{% endschema %}