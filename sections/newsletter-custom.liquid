<section class="newsletter-block">

  <div class="container">
    <h2>Faça parte da nossa lista de e-mails</h2>
    <p>Receba ofertas exclusivas e acesso antecipado.</p>

    <div class="form">
      <input type="email" placeholder="E-mail">
      <button>Inscreva-se</button>
    </div>
  </div>

</section>

<style>
.newsletter-block{
  background:#f5f5f5;
  padding:80px 20px;
  text-align:center;
}

.newsletter-block h2{
  font-size:32px;
  font-weight:300;
}

.newsletter-block input{
  padding:15px;
  border-radius:40px;
  border:1px solid #ccc;
  width:280px;
}

.newsletter-block button{
  padding:15px 25px;
  border-radius:40px;
  background:#2b0000;
  color:#fff;
  border:none;
}
</style>

{% schema %}
{
  "name": "Newsletter Premium",
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}