<section class="hero-jade">
  <div class="overlay"></div>

  <div class="content">
    <h1>Mais do que lingerie. Uma experiência.</h1>

    <p>
      Sinta-se desejada, confiante e poderosa — todos os dias.
    </p>

    <a href="/collections/all" class="btn">
      Descobrir coleção
    </a>
  </div>
</section>

<style>
.hero-jade {
  position: relative;
  height: 90vh;
  background: url('https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03') center/cover no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
}

.content {
  position: relative;
  max-width: 600px;
  padding: 20px;
}

.content h1 {
  font-size: 44px;
  margin-bottom: 15px;
  font-weight: 500;
}

.content p {
  font-size: 16px;
  margin-bottom: 25px;
  opacity: 0.9;
}

.btn {
  background: #8B1E3F;
  color: #fff;
  padding: 14px 30px;
  text-decoration: none;
  font-weight: bold;
  transition: 0.3s;
}

.btn:hover {
  background: #a52a4f;
}

@media(max-width: 768px) {
  .content h1 {
    font-size: 28px;
  }
}
</style>

{% schema %}
{
  "name": "Hero Jade",
  "settings": []
}
{% endschema %}
