{%- comment -%}
  Hero Jade — Lingerie premium, sensual e emocional.
  Editável pelo Customizer (Personalizar tema) do Shopify.
{%- endcomment -%}

<section
  class="jade-hero"
  style="
    --jade-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --jade-text: {{ section.settings.text_color }};
    --jade-accent: {{ section.settings.accent_color }};
    --jade-min-height: {{ section.settings.min_height }}vh;
  "
>
  {%- if section.settings.background_image != blank -%}
    <img
      class="jade-hero__bg"
      src="{{ section.settings.background_image | image_url: width: 2400 }}"
      srcset="
        {{ section.settings.background_image | image_url: width: 600 }} 600w,
        {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
        {{ section.settings.background_image | image_url: width: 1800 }} 1800w,
        {{ section.settings.background_image | image_url: width: 2400 }} 2400w
      "
      sizes="100vw"
      alt="{{ section.settings.background_image.alt | default: section.settings.title | escape }}"
      loading="eager"
      fetchpriority="high"
      width="{{ section.settings.background_image.width }}"
      height="{{ section.settings.background_image.height }}"
    >
  {%- else -%}
    <div class="jade-hero__bg jade-hero__bg--placeholder"></div>
  {%- endif -%}

  <div class="jade-hero__veil" aria-hidden="true"></div>

  <div class="jade-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="jade-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="jade-hero__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="jade-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="jade-hero__ctas">
      {%- if section.settings.cta_primary_text != blank -%}
        <a class="jade-hero__btn jade-hero__btn--primary"
           href="{{ section.settings.cta_primary_link | default: '#' }}">
          {{ section.settings.cta_primary_text }}
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.cta_secondary_text != blank -%}
        <a class="jade-hero__btn jade-hero__btn--ghost"
           href="{{ section.settings.cta_secondary_link | default: '#' }}">
          {{ section.settings.cta_secondary_text }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_badges -%}
      <ul class="jade-hero__badges" aria-label="Diferenciais">
        <li><span>✦</span> Tecidos premium</li>
        <li><span>✦</span> Caimento perfeito</li>
        <li><span>✦</span> Frete discreto</li>
      </ul>
    {%- endif -%}
  </div>

  <div class="jade-hero__scroll" aria-hidden="true">
    <span></span>
  </div>
</section>

<style>
  .jade-hero {
    position: relative;
    width: 100%;
    min-height: var(--jade-min-height, 92vh);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    color: var(--jade-text, #fff);
    isolation: isolate;
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
  }

  .jade-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
    transform: scale(1.05);
    animation: jadeZoom 14s ease-out forwards;
  }

  .jade-hero__bg--placeholder {
    background:
      radial-gradient(ellipse at 30% 40%, #4a2230 0%, transparent 60%),
      radial-gradient(ellipse at 70% 70%, #1a0a14 0%, transparent 70%),
      linear-gradient(135deg, #0d0509 0%, #2a0f1c 100%);
  }

  @keyframes jadeZoom {
    from { transform: scale(1.12); }
    to   { transform: scale(1.02); }
  }

  .jade-hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg,
        rgba(8, 3, 6, calc(var(--jade-overlay, 0.55) + 0.15)) 0%,
        rgba(8, 3, 6, var(--jade-overlay, 0.55)) 45%,
        rgba(8, 3, 6, calc(var(--jade-overlay, 0.55) - 0.2)) 100%);
  }

  .jade-hero__content {
    position: relative;
    max-width: 640px;
    padding: clamp(2rem, 6vw, 5rem) clamp(1.25rem, 6vw, 5rem);
    animation: jadeRise 1.1s cubic-bezier(.2,.7,.2,1) both;
  }

  @keyframes jadeRise {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .jade-hero__eyebrow {
    display: inline-block;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: .72rem;
    letter-spacing: .42em;
    text-transform: uppercase;
    color: var(--jade-accent, #d8a7b6);
    margin-bottom: 1.25rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid currentColor;
  }

  .jade-hero__title {
    font-size: clamp(2.4rem, 6.4vw, 5.2rem);
    line-height: 1.02;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem;
    font-style: italic;
  }

  .jade-hero__title em {
    font-style: italic;
    color: var(--jade-accent, #d8a7b6);
  }

  .jade-hero__subtitle {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(.95rem, 1.4vw, 1.1rem);
    line-height: 1.6;
    max-width: 46ch;
    margin: 0 0 2rem;
    opacity: .92;
    font-weight: 300;
  }

  .jade-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: .85rem 1rem;
    margin-bottom: 2.25rem;
  }

  .jade-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding: 1rem 1.85rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: .82rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    transition: transform .35s ease, background .35s ease, color .35s ease, box-shadow .35s ease;
    will-change: transform;
  }

  .jade-hero__btn--primary {
    background: var(--jade-accent, #d8a7b6);
    color: #1a0a14;
    box-shadow: 0 10px 30px -10px rgba(216, 167, 182, .6);
  }

  .jade-hero__btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -12px rgba(216, 167, 182, .8);
  }

  .jade-hero__btn--primary svg {
    transition: transform .35s ease;
  }

  .jade-hero__btn--primary:hover svg {
    transform: translateX(4px);
  }

  .jade-hero__btn--ghost {
    color: var(--jade-text, #fff);
    border: 1px solid rgba(255,255,255,.4);
    background: rgba(255,255,255,.04);
    backdrop-filter: blur(6px);
  }

  .jade-hero__btn--ghost:hover {
    background: rgba(255,255,255,.12);
    border-color: rgba(255,255,255,.7);
  }

  .jade-hero__badges {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: .72rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    opacity: .85;
  }

  .jade-hero__badges li {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
  }

  .jade-hero__badges span {
    color: var(--jade-accent, #d8a7b6);
  }

  .jade-hero__scroll {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 56px;
    background: rgba(255,255,255,.25);
    overflow: hidden;
  }

  .jade-hero__scroll span {
    display: block;
    width: 100%;
    height: 40%;
    background: var(--jade-accent, #d8a7b6);
    animation: jadeScroll 2.2s ease-in-out infinite;
  }

  @keyframes jadeScroll {
    0%   { transform: translateY(-100%); }
    100% { transform: translateY(250%); }
  }

  @media (max-width: 749px) {
    .jade-hero { min-height: 88vh; align-items: flex-end; padding-bottom: 4rem; }
    .jade-hero__content { padding-bottom: 2rem; }
    .jade-hero__btn { flex: 1 1 auto; justify-content: center; }
    .jade-hero__scroll { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .jade-hero__bg, .jade-hero__content, .jade-hero__scroll span {
      animation: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Jade",
  "tag": "section",
  "class": "section-hero-jade",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagem de fundo (modelo / lifestyle)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Jade Intimates — Coleção 2026"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título principal",
      "default": "<p>Sinta-se <em>desejada</em>.<br>Vista o que te pertence.</p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Lingeries em renda francesa, seda e tule — feitas para o corpo real e o desejo verdadeiro. Cada peça é um segredo que você decide quando contar."
    },
    {
      "type": "header",
      "content": "Botões"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Texto botão principal",
      "default": "Explorar coleção"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Link botão principal"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Texto botão secundário",
      "default": "Novidades"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Link botão secundário"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor de destaque (rosé)",
      "default": "#d8a7b6"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidade do véu escuro",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Altura mínima",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 92
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Exibir selos de confiança",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero Jade",
      "category": "Banners"
    }
  ]
}
{% endschema %}
