<section class="collection-luxo">

  <div class="collection-header">
    <h1>{{ collection.title }}</h1>
  </div>

  <div class="products-grid">

    {% paginate collection.products by section.settings.produtos_por_pagina %}

    {% for product in collection.products %}
    <div class="product-card">

      <a href="{{ product.url }}" class="image-wrapper">

        <img class="img1" src="{{ product.featured_image | image_url: width: 600 }}">

        {% if product.images.size > 1 %}
          <img class="img2" src="{{ product.images[1] | image_url: width: 600 }}">
        {% endif %}

      </a>

      <div class="jdgm-widget jdgm-preview-badge reviews" data-id="{{ product.id }}">
        {{ product.metafields.judgeme.badge }}
      </div>

      <p class="title">{{ product.title }}</p>

      <div class="price">
        {% if product.compare_at_price > product.price %}
          <span class="old">{{ product.compare_at_price | money }}</span>
        {% endif %}
        <span class="new">{{ product.price | money }}</span>
      </div>

    </div>
    {% endfor %}

    {% if paginate.pages > 1 %}
    <div class="paginacao">
      {% if paginate.previous %}
        <a href="{{ paginate.previous.url }}" class="pag-btn">← Anterior</a>
      {% endif %}

      {% for part in paginate.parts %}
        {% if part.is_link %}
          <a href="{{ part.url }}" class="pag-btn">{{ part.title }}</a>
        {% elsif part.title == paginate.current_page %}
          <span class="pag-btn pag-atual">{{ part.title }}</span>
        {% else %}
          <span class="pag-sep">{{ part.title }}</span>
        {% endif %}
      {% endfor %}

      {% if paginate.next %}
        <a href="{{ paginate.next.url }}" class="pag-btn">Próxima →</a>
      {% endif %}
    </div>
    {% endif %}

    {% endpaginate %}

  </div>

</section>

<style>

.collection-luxo{
  max-width:1200px;
  margin:0 auto;
  padding:40px 20px;
}

.collection-header h1{
  font-size:32px;
  font-weight:300;
  margin-bottom:30px;
}

.products-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:25px;
}

.product-card{
  text-align:left;
}

.image-wrapper{
  position:relative;
  display:block;
  overflow:hidden;
}

.img1{
  width:100%;
  transition:opacity 0.4s;
  display:block;
}

.img2{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  opacity:0;
  transition:opacity 0.4s;
  pointer-events:none;
}

@media(hover:hover){
  .image-wrapper:hover .img2{ opacity:1; }
  .image-wrapper:hover .img1{ opacity:0; }
}

.title{
  font-size:13px;
  margin-top:10px;
}

.price{
  font-size:14px;
  margin-top:5px;
}

.old{
  text-decoration:line-through;
  color:#aaa;
  margin-right:6px;
}

.new{
  color:#8B1E3F;
  font-weight:500;
}

.reviews{
  margin-top:8px;
  font-size:12px;
}

/* PAGINAÇÃO */
.paginacao{
  grid-column:1/-1;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:8px;
  margin-top:40px;
  flex-wrap:wrap;
}

.pag-btn{
  padding:8px 16px;
  border:1px solid #ddd;
  border-radius:4px;
  text-decoration:none;
  font-size:13px;
  color:#111;
  transition:0.3s;
}

.pag-btn:hover{
  background:#2b0000;
  color:#fff;
  border-color:#2b0000;
}

.pag-atual{
  background:#2b0000;
  color:#fff;
  border-color:#2b0000;
  cursor:default;
}

.pag-sep{
  font-size:13px;
  color:#aaa;
  padding:8px 4px;
}

@media(max-width:768px){
  .products-grid{ grid-template-columns:repeat(2,1fr); }
}

</style>

{% schema %}
{
  "name": "Coleção",
  "settings": [
    {
      "type": "range",
      "id": "produtos_por_pagina",
      "label": "Produtos por página",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}