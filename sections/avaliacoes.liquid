<section class="avaliacoes">
  <div class="avaliacoes-container">

    <div class="avaliacoes-head">
      <span>{{ section.settings.kicker }}</span>
      <h2>{{ section.settings.titulo }}</h2>
      <p>{{ section.settings.subtitulo }}</p>
    </div>

    <div class="avaliacoes-wrapper">
      <button class="av-arrow av-arrow-left" onclick="scrollAvaliacoes(-1)" aria-label="Anterior">&#8592;</button>

      <div class="avaliacoes-track" id="avaliacoesTrack">
        {% for block in section.blocks %}
          <div class="av-card" {{ block.shopify_attributes }}>
            <div class="av-stars">
              {% for i in (1..block.settings.estrelas) %}★{% endfor %}
            </div>
            {% if block.settings.produto != blank %}
              <span class="av-produto">{{ block.settings.produto }}</span>
            {% endif %}
            <p class="av-texto">"{{ block.settings.texto }}"</p>
            <span class="av-nome">— {{ block.settings.nome }}</span>
          </div>
        {% endfor %}
      </div>

      <button class="av-arrow av-arrow-right" onclick="scrollAvaliacoes(1)" aria-label="Próximo">&#8594;</button>
    </div>

  </div>
</section>

<style>
.avaliacoes{background:#f7f7f7;padding:80px 20px}
.avaliacoes-container{max-width:1100px;margin:0 auto}
.avaliacoes-head{text-align:center;margin-bottom:45px}
.avaliacoes-head span{display:block;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#7a6a6a}
.avaliacoes-head h2{font-size:36px;font-weight:300;letter-spacing:2px;margin:12px 0;color:#111}
.avaliacoes-head p{font-size:14px;color:#888;margin:0}

.avaliacoes-wrapper{position:relative;display:flex;align-items:center;gap:12px}

.avaliacoes-track{
  display:flex;
  gap:24px;
  overflow:hidden;
  scroll-behavior:smooth;
  width:100%;
}

.av-card{
  background:#fff;
  border-radius:12px;
  padding:28px;
  box-shadow:0 2px 12px rgba(0,0,0,0.06);
  flex:0 0 calc(33.333% - 16px);
  min-width:calc(33.333% - 16px);
  box-sizing:border-box;
}

.av-stars{color:#c8a04a;font-size:18px;margin-bottom:8px;letter-spacing:2px}
.av-produto{display:inline-block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#8B1E3F;font-weight:600;margin-bottom:12px;border-bottom:1px solid #f0d0d8;padding-bottom:8px;width:100%}
.av-texto{font-size:14px;color:#444;line-height:1.7;margin-bottom:16px;font-style:italic}
.av-nome{font-size:12px;color:#999;letter-spacing:1px;text-transform:uppercase}

.av-arrow{
  flex-shrink:0;
  width:42px;
  height:42px;
  border-radius:50%;
  background:#8B1E3F;
  color:#fff;
  border:none;
  font-size:18px;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:0.2s;
  padding:0;
  line-height:1;
}
.av-arrow:hover{background:#4D0405}

@media(min-width:769px){
  .av-card{flex:0 0 calc(33.333% - 16px);min-width:calc(33.333% - 16px)}
}

@media(max-width:768px){
  .avaliacoes{padding:50px 16px}
  .avaliacoes-head h2{font-size:25px}
  .av-card{flex:0 0 100%;min-width:100%}
  .av-arrow{width:36px;height:36px;font-size:15px}
}
</style>

<script>
function scrollAvaliacoes(direction) {
  const track = document.getElementById('avaliacoesTrack');
  const card = track.querySelector('.av-card');
  const cardWidth = card.offsetWidth + 24;
  const isMobile = window.innerWidth <= 768;
  const scrollAmount = isMobile ? cardWidth : cardWidth * 3;
  track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
}
</script>

{% schema %}
{
  "name": "Avaliações",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Texto pequeno",
      "default": "CLIENTES JADE"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "O que dizem sobre nós"
    },
    {
      "type": "text",
      "id": "subtitulo",
      "label": "Subtítulo",
      "default": "Avaliações reais de quem já viveu a experiência."
    }
  ],
  "blocks": [
    {
      "type": "avaliacao",
      "name": "Avaliação",
      "settings": [
        {
          "type": "range",
          "id": "estrelas",
          "label": "Estrelas",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "produto",
          "label": "Produto avaliado",
          "default": "Conjunto Sirena"
        },
        {
          "type": "textarea",
          "id": "texto",
          "label": "Texto da avaliação",
          "default": "Amei o produto, qualidade incrível!"
        },
        {
          "type": "text",
          "id": "nome",
          "label": "Nome da cliente",
          "default": "Maria S."
        }
      ]
    }
  ],
  "presets": [{ "name": "Avaliações" }]
}
{% endschema %}