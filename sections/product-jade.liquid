<form method="post" action="/cart/add" id="product-form">
  <input type="hidden" name="id" id="variant-id" value="{{ product.variants.first.id }}">

  <!-- CORES -->
  <div class="option-group">
    <p>Cor</p>
    <div class="options">
      {% assign colors = product.options_with_values[0].values %}
      {% for value in colors %}
        <button type="button" class="option-btn" onclick="selectOption(0, '{{ value }}')">
          {{ value }}
        </button>
      {% endfor %}
    </div>
  </div>

  <!-- TAMANHOS -->
  <div class="option-group">
    <p>Tamanho</p>
    <div class="options">
      {% assign sizes = product.options_with_values[1].values %}
      {% for value in sizes %}
        <button type="button" class="option-btn" onclick="selectOption(1, '{{ value }}')">
          {{ value }}
        </button>
      {% endfor %}
    </div>
  </div>

  <button type="submit" class="btn">
    Adicionar ao carrinho
  </button>
</form>.option-group {
  margin-bottom: 20px;
}

.option-group p {
  font-weight: bold;
  margin-bottom: 8px;
}

.options {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.option-btn {
  padding: 8px 14px;
  border: 1px solid #ccc;
  background: #fff;
  cursor: pointer;
  border-radius: 6px;
}

.option-btn.active {
  border: 2px solid #8B1E3F;
}