<section class="product-premium">
  <div class="wrap">

    <!-- GALERIA -->
    <div class="gallery">
      <div class="main-image">
        <img src="{{ product.featured_image | image_url: width: 900 }}">
      </div>

      <div class="thumbs">
        {% for image in product.images %}
          <img src="{{ image | image_url: width: 300 }}">
        {% endfor %}
      </div>
    </div>

    <!-- INFO -->
    <div class="info">
      <h1>{{ product.title }}</h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      <p class="desc">
        {{ product.description | strip_html }}
      </p>

      <!-- VARIANTES BONITAS -->
      <form method="post" action="/cart/add" id="product-form">
        <input type="hidden" name="id" id="variant-id" value="{{ product.variants.first.id }}">

        <!-- COR -->
        <div class="option-group">
          <p>Cor</p>
          <div class="options">
            {% for value in product.options_with_values[0].values %}
              <button type="button" class="option-btn" onclick="selectOption(0, '{{ value }}')">
                {{ value }}
              </button>
            {% endfor %}
          </div>
        </div>

        <!-- TAMANHO -->
        <div class="option-group">
          <p>Tamanho</p>
          <div class="options">
            {% for value in product.options_with_values[1].values %}
              <button type="button" class="option-btn" onclick="selectOption(1, '{{ value }}')">
                {{ value }}
              </button>
            {% endfor %}
          </div>
        </div>

        <button class="btn">
          Adicionar ao carrinho
        </button>
      </form>

      <div class="meta">
        🔥 Últimas unidades disponíveis <br>
        ✔ Frete rápido • ✔ Troca fácil
      </div>
    </div>

  </div>
</section>

<style>
.product-premium {
  max-width: 1200px;
  margin: auto;
  padding: 60px 20px;
}

.wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}

.main-image img {
  width: 100%;
  border-radius: 10px;
}

.thumbs {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.thumbs img {
  width: 70px;
  height: 90px;
  object-fit: cover;
  border-radius: 6px;
  opacity: 0.6;
  cursor: pointer;
}

.thumbs img:hover {
  opacity: 1;
}

.info h1 {
  font-size: 32px;
  font-weight: 400;
  margin-bottom: 15px;
}

.price {
  font-size: 22px;
  color: #8B1E3F;
  margin-bottom: 20px;
}

.desc {
  font-size: 14px;
  color: #444;
  margin-bottom: 30px;
}

/* VARIANTES */
.option-group {
  margin-bottom: 20px;
}

.option-group p {
  font-weight: bold;
  margin-bottom: 8px;
}

.options {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.option-btn {
  padding: 8px 14px;
  border: 1px solid #ccc;
  background: #fff;
  cursor: pointer;
  border-radius: 6px;
}

.option-btn.active {
  border: 2px solid #8B1E3F;
}

/* BOTÃO */
.btn {
  width: 100%;
  background: #8B1E3F;
  color: #fff;
  padding: 16px;
  border: none;
  font-size: 15px;
  text-transform: uppercase;
  border-radius: 6px;
  cursor: pointer;
}

.meta {
  margin-top: 20px;
  font-size: 13px;
  color: #777;
}

/* MOBILE */
@media(max-width: 768px){
  .wrap {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
let selectedOptions = [];

function selectOption(index, value) {
  selectedOptions[index] = value;

  const groups = document.querySelectorAll('.options');
  const buttons = groups[index].querySelectorAll('button');

  buttons.forEach(btn => {
    btn.classList.remove('active');
    if (btn.innerText === value) {
      btn.classList.add('active');
    }
  });

  updateVariant();
}

function updateVariant() {
  const variants = {{ product.variants | json }};
  
  const found = variants.find(v => {
    return selectedOptions.every((opt, i) => v.options[i] === opt);
  });

  if (found) {
    document.getElementById('variant-id').value = found.id;
  }
}
</script>