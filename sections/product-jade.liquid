<section class="product-premium">
  <div class="wrap">

    <div class="gallery">
      <div class="main-image">
        <img id="mainImage" src="{{ product.featured_image | image_url: width: 900 }}">
      </div>
      <div class="thumbs">
        {% for image in product.images %}
          <img src="{{ image | image_url: width: 300 }}" onclick="trocarImagem(this)">
        {% endfor %}
      </div>
    </div>

    <div class="info">
      <h1>{{ product.title }}</h1>

      <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
      </div>

      <div class="price">
        {% if product.compare_at_price > product.price %}
          <span class="price-old">{{ product.compare_at_price | money }}</span>
          <span class="price-atual">{{ product.price | money }}</span>
        {% else %}
          <span class="price-atual">{{ product.price | money }}</span>
        {% endif %}
      </div>

      <form method="post" action="/cart/add" id="product-form">
        <input type="hidden" name="id" id="variant-id" value="">

        <div class="option-group">
          <p>Cor: <span id="cor-selecionada" class="opcao-label">—</span></p>
          <div class="color-options">
            {% for value in product.options_with_values[0].values %}
              <div class="color-btn" data-value="{{ value }}"
                data-hex="{% if value == 'Preto' %}#000{% elsif value == 'Vermelho' %}#8B1E3F{% elsif value == 'Rosa' %}#e8a1b0{% else %}#2b0000{% endif %}"
                style="background:{% if value == 'Preto' %}#000{% elsif value == 'Vermelho' %}#8B1E3F{% elsif value == 'Rosa' %}#e8a1b0{% else %}#ccc{% endif %}"
                onclick="selectOption(0, '{{ value }}', this)">
              </div>
            {% endfor %}
          </div>
        </div>

        {% if product.options.size > 1 %}
        <div class="option-group">
          <p>Tamanho: <span id="tamanho-selecionado" class="opcao-label">—</span></p>
          <div class="size-options">
            {% for value in product.options_with_values[1].values %}
              <button type="button" class="size-btn" data-value="{{ value }}" onclick="selectOption(1, '{{ value }}', this)">{{ value }}</button>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if product.metafields.custom.guia_de_medidas != blank %}
          <a href="{{ product.metafields.custom.guia_de_medidas }}" target="_blank" class="size-guide-link">
            ↔ Guia de medidas
          </a>
        {% endif %}

        <div id="stock-msg" class="stock-msg" style="display:none"></div>

        <div class="btn-group">
          <button type="button" class="btn btn-cart" id="btn-cart" onclick="adicionarCarrinho()">Adicionar ao carrinho</button>
          <button type="button" class="btn btn-buy" id="btn-buy" onclick="comprarAgora()">Comprar agora</button>
        </div>

      </form>

      <div class="meta">
        ✔ Frete grátis • ✔ Troca em até 7 dias
      </div>

      <div class="desc-title">Descrição</div>
      <div class="desc">{{ product.description }}</div>

    </div>
  </div>

  <!-- PRODUTOS RELACIONADOS -->
  <div class="relacionados">
    <h2>Você também pode gostar</h2>
    <div class="relacionados-grid" id="relacionados-grid"></div>
  </div>

</section>

<style>
.product-premium{max-width:1200px;margin:auto;padding:60px 20px}
.wrap{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.main-image img{width:100%;border-radius:10px}
.thumbs{display:flex;gap:10px;margin-top:12px}
.thumbs img{width:70px;height:90px;object-fit:cover;border-radius:6px;opacity:0.6;cursor:pointer}
.thumbs img:hover{opacity:1}
.info{max-width:420px}
.info h1{font-size:30px;font-weight:400;line-height:1.3;margin-bottom:10px}
.price{margin-bottom:20px;display:flex;align-items:center;gap:10px}
.price-old{font-size:16px;color:#999;text-decoration:line-through}
.price-atual{font-size:22px;color:#8B1E3F;font-weight:600}
.option-group{margin-bottom:25px}
.option-group p{font-size:13px;font-weight:600;margin-bottom:10px}
.opcao-label{color:#2b0000;font-weight:600}
.color-options{display:flex;gap:10px;flex-wrap:wrap}
.color-btn{width:28px;height:28px;border-radius:50%;border:2px solid transparent;cursor:pointer;transition:0.2s}
.color-btn.active{transform:scale(1.2);box-shadow:0 0 0 2px #fff,0 0 0 4px #2b0000}
.size-options{display:flex;gap:10px;flex-wrap:wrap}
.size-btn{padding:8px 14px;border:1px solid #ccc;background:#fff;cursor:pointer;border-radius:4px;font-size:13px;transition:0.2s;color:#111}
.size-btn.active{color:#fff;font-weight:600;border-width:2px}
.size-btn.esgotado{opacity:0.35;text-decoration:line-through;cursor:not-allowed}
.size-guide-link{display:inline-block;font-size:13px;color:#555;text-decoration:underline;margin-bottom:24px}
.stock-msg{font-size:13px;color:#c0392b;margin-bottom:12px;padding:10px;background:#fdf0f0;border-radius:6px}
.btn-group{display:flex;flex-direction:column;gap:10px;margin-top:10px}
.btn{width:100%;padding:16px;border:none;font-size:14px;letter-spacing:1px;text-transform:uppercase;border-radius:6px;cursor:pointer;text-align:center;text-decoration:none;display:block;box-sizing:border-box}
.btn-cart{background:#8B1E3F;color:#fff}
.btn-buy{background:#fff;color:#8B1E3F;border:2px solid #8B1E3F}
.btn:disabled{opacity:0.4;cursor:not-allowed}
.meta{margin-top:20px;font-size:12px;color:#777;line-height:1.6;margin-bottom:32px}
.desc-title{font-size:16px;font-weight:600;color:#111;padding-bottom:12px;border-bottom:1px solid #eee;margin-bottom:16px}
.desc{font-size:14px;line-height:1.8;color:#555}
.desc p{margin-bottom:12px}
.desc strong{display:block;margin-top:20px;margin-bottom:6px;font-weight:600}
.desc table{width:100%;margin-top:10px;border-collapse:collapse;font-size:13px}
.desc table td,.desc table th{padding:6px;border-bottom:1px solid #eee;text-align:left}
.relacionados{margin-top:60px;padding-top:40px;border-top:1px solid #eee}
.relacionados h2{font-size:22px;font-weight:300;margin-bottom:24px;color:#111}
.relacionados-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.rel-card{text-decoration:none;color:#111;display:block}
.rel-card img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:8px;display:block}
.rel-card p{font-size:13px;margin-top:8px}
.rel-card .rel-price{font-size:13px;color:#8B1E3F;font-weight:600;margin-top:4px}
@media(max-width:768px){
  .wrap{grid-template-columns:1fr;gap:32px}
  .info{max-width:100%}
  .relacionados-grid{grid-template-columns:repeat(2,1fr)}
}
</style>

<script>
const variants = {{ product.variants | json }};
const totalOptions = {{ product.options.size }};
let selectedOptions = new Array(totalOptions).fill(null);
let corHexAtual = '#2b0000';

function getCorHex(el) {
  return el.dataset.hex || '#2b0000';
}

function atualizarCorTamanho() {
  document.querySelectorAll('.size-btn.active').forEach(btn => {
    btn.style.background = corHexAtual;
    btn.style.borderColor = corHexAtual;
  });
  const label = document.getElementById('cor-selecionada');
  if(label) label.style.color = corHexAtual;
}

function selectOption(index, value, el) {
  selectedOptions[index] = value;
  el.parentElement.querySelectorAll('*').forEach(b => b.classList.remove('active'));
  el.classList.add('active');

  if(index === 0){
    corHexAtual = getCorHex(el);
    const label = document.getElementById('cor-selecionada');
    if(label) label.textContent = value;
  }
  if(index === 1){
    const label = document.getElementById('tamanho-selecionado');
    if(label) label.textContent = value;
  }

  atualizarCorTamanho();
  updateVariant();
  atualizarSizes();
}

function atualizarSizes() {
  document.querySelectorAll('.size-btn').forEach(btn => {
    const sizeValue = btn.dataset.value;
    const testOptions = [...selectedOptions];
    testOptions[1] = sizeValue;
    const v = variants.find(v => v.options.every((opt, i) => testOptions[i] === null || opt === testOptions[i]));
    if(v && !v.available){
      btn.classList.add('esgotado');
    } else {
      btn.classList.remove('esgotado');
    }
    if(btn.classList.contains('active')){
      btn.style.background = corHexAtual;
      btn.style.borderColor = corHexAtual;
    }
  });
}

function updateVariant() {
  const found = variants.find(v => v.options.every((opt, i) => opt === selectedOptions[i]));
  const stockMsg = document.getElementById('stock-msg');
  const btnCart = document.getElementById('btn-cart');
  const btnBuy = document.getElementById('btn-buy');
  if(found){
    document.getElementById('variant-id').value = found.id;
    if(!found.available){
      stockMsg.style.display = 'block';
      stockMsg.textContent = 'Esta variante está esgotada.';
      btnCart.disabled = true;
      btnBuy.disabled = true;
    } else {
      stockMsg.style.display = 'none';
      btnCart.disabled = false;
      btnBuy.disabled = false;
    }
  }
}

function validarOpcoes() {
  if(selectedOptions.some(o => o === null)){
    alert('Por favor, selecione cor e tamanho antes de continuar.');
    return false;
  }
  return true;
}

function adicionarCarrinho() {
  if(!validarOpcoes()) return;
  document.getElementById('product-form').submit();
}

function comprarAgora() {
  if(!validarOpcoes()) return;
  const variantId = document.getElementById('variant-id').value;
  fetch('/cart/add.js', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({id: parseInt(variantId), quantity: 1})
  })
  .then(() => { window.location.href = '/checkout'; })
  .catch(err => console.error(err));
}

function trocarImagem(el){ document.getElementById("mainImage").src = el.src; }

fetch(`/recommendations/products.json?product_id={{ product.id }}&limit=4`)
  .then(r => r.json())
  .then(data => {
    const grid = document.getElementById('relacionados-grid');
    if(!data.products || data.products.length === 0){
      document.querySelector('.relacionados').style.display = 'none';
      return;
    }
    grid.innerHTML = data.products.map(p => `
      <a href="${p.url}" class="rel-card">
        <img src="${p.featured_image}" alt="${p.title}">
        <p>${p.title}</p>
        <p class="rel-price">R$ ${(p.price/100).toFixed(2).replace('.',',')}</p>
      </a>
    `).join('');
  });
</script>