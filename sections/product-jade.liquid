<section class="product">
  <div class="product-container">

    <!-- IMAGEM -->
    <div class="product-images">
      {% for image in product.images %}
        <img src="{{ image | image_url: width: 600 }}">
      {% endfor %}
    </div>

    <!-- INFO -->
    <div class="product-info">
      <h1>{{ product.title }}</h1>

      <p class="price">{{ product.price | money }}</p>

      <p class="desc">
        {{ product.description }}
      </p>

      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <button type="submit" class="btn">
          Adicionar ao carrinho
        </button>
      </form>

      <p class="urgency">🔥 Últimas unidades disponíveis</p>
    </div>

  </div>
</section>

<style>
.product-container {
  display: flex;
  gap: 40px;
  padding: 40px;
}

.product-images img {
  width: 100%;
  margin-bottom: 10px;
}

.product-info {
  max-width: 400px;
}

.price {
  font-size: 22px;
  color: #8B1E3F;
  font-weight: bold;
}

.btn {
  background: #8B1E3F;
  color: white;
  padding: 15px;
  border: none;
  width: 100%;
  margin-top: 15px;
  cursor: pointer;
}

.urgency {
  color: red;
  margin-top: 10px;
}
</style>