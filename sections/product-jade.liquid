<section class="product-premium">
  <div class="wrap">

    <!-- GALERIA -->
    <div class="gallery">
      <div class="main-image">
        <img id="mainImage" src="{{ product.featured_image | image_url: width: 900 }}">
      </div>
      <div class="thumbs">
        {% for image in product.images %}
          <img src="{{ image | image_url: width: 300 }}" onclick="trocarImagem(this)">
        {% endfor %}
      </div>
    </div>

    <!-- INFO -->
    <div class="info">
      <h1>{{ product.title }}</h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      <form method="post" action="/cart/add" id="product-form">
        <input type="hidden" name="id" id="variant-id" value="{{ product.variants.first.id }}">

        <!-- COR -->
        <div class="option-group">
          <p>Cor</p>
          <div class="color-options">
            {% for value in product.options_with_values[0].values %}
              <div
                class="color-btn"
                data-value="{{ value }}"
                style="background:
                  {% if value == 'Preto' %}#000
                  {% elsif value == 'Vermelho' %}#8B1E3F
                  {% elsif value == 'Rosa' %}#e8a1b0
                  {% else %}#ccc{% endif %}"
                onclick="selectOption(0, '{{ value }}', this)">
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- TAMANHO -->
        <div class="option-group">
          <p>Tamanho</p>
          <div class="size-options">
            {% for value in product.options_with_values[1].values %}
              <button type="button" class="size-btn" onclick="selectOption(1, '{{ value }}', this)">
                {{ value }}
              </button>
            {% endfor %}
          </div>
        </div>

        <!-- GUIA DE MEDIDAS -->
        {% if product.metafields.custom.size_guide_url != blank %}
          <a href="{{ product.metafields.custom.size_guide_url }}" target="_blank" class="size-guide-link">
            ↔ Guia de medidas
          </a>
        {% endif %}

        <!-- BOTÕES -->
        <div class="btn-group">
          <button type="submit" class="btn btn-cart">
            Adicionar ao carrinho
          </button>
          <a href="/checkout?variant={{ product.variants.first.id }}" id="buy-now" class="btn btn-buy">
            Comprar agora
          </a>
        </div>

      </form>

      <div class="meta">
        🔥 Últimas unidades disponíveis <br>
        ✔ Frete grátis • ✔ Troca em até 7 dias
      </div>

      <!-- DESCRIÇÃO NO FINAL -->
      <div class="desc-title">Descrição</div>
      <div class="desc">
        {{ product.description }}
      </div>

    </div>

  </div>
</section>

<style>
.product-premium {
  max-width: 1200px;
  margin: auto;
  padding: 60px 20px;
}

.wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}

/* GALERIA */
.main-image img {
  width: 100%;
  border-radius: 10px;
}

.thumbs {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.thumbs img {
  width: 70px;
  height: 90px;
  object-fit: cover;
  border-radius: 6px;
  opacity: 0.6;
  cursor: pointer;
}

.thumbs img:hover {
  opacity: 1;
}

/* TEXTO */
.info {
  max-width: 420px;
}

.info h1 {
  font-size: 30px;
  font-weight: 400;
  line-height: 1.3;
  margin-bottom: 10px;
}

.price {
  font-size: 20px;
  color: #8B1E3F;
  margin-bottom: 20px;
}

/* VARIANTES */
.option-group {
  margin-bottom: 25px;
}

.option-group p {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 10px;
}

/* CORES */
.color-options {
  display: flex;
  gap: 10px;
}

.color-btn {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid #ccc;
  cursor: pointer;
}

.color-btn.active {
  border: 2px solid #000;
}

/* TAMANHO */
.size-options {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.size-btn {
  padding: 8px 14px;
  border: 1px solid #ccc;
  background: #fff;
  cursor: pointer;
  border-radius: 4px;
  font-size: 13px;
}

.size-btn.active {
  border: 2px solid #000;
  background: #000;
  color: #fff;
}

/* GUIA DE MEDIDAS */
.size-guide-link {
  display: inline-block;
  font-size: 13px;
  color: #555;
  text-decoration: underline;
  margin-bottom: 24px;
}

/* BOTÕES */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 10px;
}

.btn {
  width: 100%;
  padding: 16px;
  border: none;
  font-size: 14px;
  letter-spacing: 1px;
  text-transform: uppercase;
  border-radius: 6px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  display: block;
}

.btn-cart {
  background: #8B1E3F;
  color: #fff;
}

.btn-buy {
  background: #fff;
  color: #8B1E3F;
  border: 2px solid #8B1E3F;
}

/* META */
.meta {
  margin-top: 20px;
  font-size: 12px;
  color: #777;
  line-height: 1.6;
  margin-bottom: 32px;
}

/* DESCRIÇÃO */
.desc-title {
  font-size: 16px;
  font-weight: 600;
  color: #111;
  padding-bottom: 12px;
  border-bottom: 1px solid #eee;
  margin-bottom: 16px;
}

.desc {
  font-size: 14px;
  line-height: 1.8;
  color: #555;
}

.desc p { margin-bottom: 12px; }

.desc strong {
  display: block;
  margin-top: 20px;
  margin-bottom: 6px;
  font-weight: 600;
}

.desc table {
  width: 100%;
  margin-top: 10px;
  border-collapse: collapse;
  font-size: 13px;
}

.desc table td,
.desc table th {
  padding: 6px;
  border-bottom: 1px solid #eee;
  text-align: left;
}

/* MOBILE */
@media(max-width: 768px){
  .wrap {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .info {
    max-width: 100%;
  }
}
</style>

<script>
let selectedOptions = [];

function selectOption(index, value, el) {
  selectedOptions[index] = value;
  const parent = el.parentElement;
  parent.querySelectorAll('*').forEach(btn => btn.classList.remove('active'));
  el.classList.add('active');
  updateVariant();
}

function updateVariant() {
  const variants = {{ product.variants | json }};
  const found = variants.find(v => selectedOptions.every((opt, i) => v.options[i] === opt));
  if (found) {
    document.getElementById('variant-id').value = found.id;
    document.getElementById('buy-now').href = '/checkout?variant=' + found.id;
  }
}

function trocarImagem(el){
  document.getElementById("mainImage").src = el.src;
}
</script>