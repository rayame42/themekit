<section class="product-jade">
  <div class="container">

    <!-- IMAGENS -->
    <div class="images">
      {% for image in product.images %}
        <img src="{{ image | image_url: width: 600 }}">
      {% endfor %}
    </div>

    <!-- INFO -->
    <div class="info">
      <h1>{{ product.title }}</h1>

      <div class="price">
        {{ product.price | money }}
      </div>

      <p class="desc">
        {{ product.description | strip_html | truncate: 300 }}
      </p>

      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">

        <button type="submit" class="btn">
          Adicionar ao carrinho
        </button>
      </form>

      <p class="urgency">
        🔥 Últimas unidades disponíveis
      </p>

      <p class="trust">
        ✔ Frete rápido • ✔ Troca fácil • ✔ Compra segura
      </p>
    </div>

  </div>
</section>

<style>
.product-jade {
  max-width: 1100px;
  margin: auto;
  padding: 60px 20px;
}

.container {
  display: flex;
  gap: 60px;
  align-items: flex-start;
}

/* IMAGENS */
.images {
  width: 45%;
}

.images img {
  width: 100%;
  max-width: 420px;
  display: block;
  margin-bottom: 15px;
  border-radius: 12px;
}

/* INFO */
.info {
  width: 55%;
}

.info h1 {
  font-size: 34px;
  font-weight: 500;
  margin-bottom: 15px;
}

.price {
  font-size: 26px;
  font-weight: bold;
  color: #8B1E3F;
  margin-bottom: 20px;
}

.desc {
  font-size: 15px;
  color: #444;
  line-height: 1.6;
  margin-bottom: 30px;
}

/* BOTÃO */
.btn {
  width: 100%;
  background: #8B1E3F;
  color: #fff;
  padding: 16px;
  border: none;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  border-radius: 8px;
  transition: 0.3s;
}

.btn:hover {
  background: #6f1832;
}

/* URGÊNCIA */
.urgency {
  color: #b30000;
  font-size: 14px;
  margin-top: 12px;
}

/* CONFIANÇA */
.trust {
  font-size: 13px;
  color: #777;
  margin-top: 15px;
}

/* MOBILE */
@media(max-width: 768px){
  .container {
    flex-direction: column;
  }

  .images, .info {
    width: 100%;
  }

  .images img {
    max-width: 100%;
  }
}
</style>