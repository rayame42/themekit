.desc {
  font-size: 15px;
  line-height: 1.6;
  color: #444;
  margin-bottom: 25px;
  max-width: 420px;
}

/* BOTÕES */
.btn {
  width: 100%;
  padding: 14px;
  border-radius: 6px;
  font-size: 14px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: 0.3s;
}

.btn.primary {
  background: #8B1E3F;
  color: #fff;
  border: none;
}

.btn.primary:hover {
  background: #6f1832;
}

.btn.secondary {
  background: transparent;
  border: 1px solid #8B1E3F;
  color: #8B1E3F;
}

.btn.secondary:hover {
  background: #8B1E3F;
  color: #fff;
}