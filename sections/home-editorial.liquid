<section class="home-editorial">

  <!-- TOP BAR -->
  <div class="topbar">
    Frete grátis • 6x sem juros • 15% OFF em toda loja
  </div>

  <!-- HERO -->
  <div class="hero" style="background-image: url({{ section.settings.hero_image | image_url: width: 2000 }});">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1>{{ section.settings.hero_title }}</h1>
      <p>{{ section.settings.hero_subtitle }}</p>
      <a href="{{ section.settings.hero_link }}" class="btn-primary">
        {{ section.settings.hero_button }}
      </a>
    </div>
  </div>

  <!-- CATEGORIAS EDITORIAIS -->
  <div class="editorial-grid">
    {% for block in section.blocks %}
      {% if block.type == 'categoria' %}
        <a href="{{ block.settings.link }}" class="editorial-item">
          <img src="{{ block.settings.image | image_url: width: 800 }}">
          <span>{{ block.settings.title }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  <!-- PRODUTOS -->
  <div class="products">
    <h2>Mais desejados</h2>

    <div class="products-grid">
      {% for product in collections[section.settings.collection].products limit: 4 %}
        <a href="{{ product.url }}" class="card">
          <img src="{{ product.featured_image | image_url: width: 600 }}">

          <div class="card-info">
            <p class="title">{{ product.title }}</p>

            <div class="price">
              {% if product.compare_at_price > product.price %}
                <span class="old">{{ product.compare_at_price | money }}</span>
              {% endif %}
              <span class="new">{{ product.price | money }}</span>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>

</section>

<style>
/* BASE */
.home-editorial {
  max-width: 1200px;
  margin: auto;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

/* TOPBAR */
.topbar {
  background: #111;
  color: #fff;
  text-align: center;
  padding: 10px;
  font-size: 12px;
  letter-spacing: 1px;
}

/* HERO */
.hero {
  position: relative;
  height: 80vh;
  background-size: cover;
  background-position: center;
  margin-bottom: 60px;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
}

.hero-content {
  position: absolute;
  bottom: 60px;
  left: 60px;
  color: #fff;
  max-width: 400px;
}

.hero h1 {
  font-size: 42px;
  font-weight: 300;
  margin-bottom: 10px;
}

.hero p {
  font-size: 15px;
  margin-bottom: 20px;
  opacity: 0.9;
}

/* BOTÃO */
.btn-primary {
  background: #8B1E3F;
  color: #fff;
  padding: 14px 28px;
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 1px;
}

/* GRID EDITORIAL */
.editorial-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 15px;
  padding: 0 20px;
  margin-bottom: 80px;
}

.editorial-item {
  position: relative;
  display: block;
}

.editorial-item img {
  width: 100%;
  height: 420px;
  object-fit: cover;
}

.editorial-item span {
  position: absolute;
  bottom: 20px;
  left: 20px;
  color: #fff;
  font-size: 18px;
}

/* PRODUTOS */
.products {
  padding: 0 20px 60px;
}

.products h2 {
  text-align: center;
  font-weight: 400;
  margin-bottom: 40px;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 20px;
}

.card img {
  width: 100%;
  height: 380px;
  object-fit: cover;
}

.card-info {
  padding-top: 10px;
  text-align: center;
}

.title {
  font-size: 13px;
}

.price {
  margin-top: 5px;
  font-size: 13px;
}

.old {
  text-decoration: line-through;
  color: #999;
  margin-right: 5px;
}

.new {
  color: #8B1E3F;
}

/* MOBILE */
@media(max-width:768px){
  .hero {
    height: 60vh;
  }

  .editorial-grid {
    grid-template-columns: 1fr;
  }

  .products-grid {
    grid-template-columns: 1fr 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Home Editorial Premium",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagem principal"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Título",
      "default": "Mais do que lingerie. Uma experiência."
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Subtítulo",
      "default": "Sinta-se desejada, confiante e poderosa."
    },
    {
      "type": "text",
      "id": "hero_button",
      "label": "Texto botão",
      "default": "Descobrir coleção"
    },
    {
      "type": "url",
      "id": "hero_link",
      "label": "Link botão"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção produtos"
    }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Home Editorial Premium"
    }
  ]
}
{% endschema %}