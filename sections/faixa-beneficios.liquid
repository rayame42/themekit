<section class="beneficios">
  <div class="beneficios-container">

    <div class="beneficio-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      <div>
        <strong>Frete Grátis</strong>
        <span>Para todo o Brasil</span>
      </div>
    </div>

    <div class="beneficio-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
      <div>
        <strong>6x Sem Juros</strong>
        <span>No cartão de crédito</span>
      </div>
    </div>

    <div class="beneficio-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <div>
        <strong>Compra Segura</strong>
        <span>Site criptografado</span>
      </div>
    </div>

    <div class="beneficio-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
      <div>
        <strong>Embalagem Discreta</strong>
        <span>Sua privacidade garantida</span>
      </div>
    </div>

    <a href="/pages/politica-de-troca-reembolso-cancelamento" class="beneficio-item beneficio-link">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1018 0 9 9 0 00-18 0z"/><path d="M12 8v4l3 3"/></svg>
      <div>
        <strong>Troca Fácil</strong>
        <span>Até 7 dias após a entrega</span>
      </div>
    </a>

  </div>
</section>

<style>
.beneficios{
  background:#fff;
  border-top:1px solid #f0f0f0;
  border-bottom:1px solid #f0f0f0;
  padding:20px;
}

.beneficios-container{
  max-width:1100px;
  margin:auto;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  gap:32px;
}

.beneficio-item{
  display:flex;
  align-items:center;
  gap:12px;
}

.beneficio-item svg{
  width:28px;
  height:28px;
  color:#2b0000;
  flex-shrink:0;
}

.beneficio-item div{
  display:flex;
  flex-direction:column;
}

.beneficio-item strong{
  font-size:13px;
  font-weight:600;
  color:#111;
  letter-spacing:0.3px;
}

.beneficio-item span{
  font-size:11px;
  color:#888;
  margin-top:1px;
}

.beneficio-link{
  text-decoration:none;
  color:inherit;
}

.beneficio-link:hover strong{
  color:#2b0000;
}

@media(max-width:768px){
  .beneficios{ padding:16px; }
  .beneficios-container{ gap:16px; }
  .beneficio-item{ width:calc(50% - 8px); }
  .beneficio-item svg{ width:22px; height:22px; }
  .beneficio-item strong{ font-size:12px; }
  .beneficio-item span{ font-size:10px; }
}
</style>

{% schema %}
{
  "name": "Faixa de Benefícios",
  "presets": [{ "name": "Faixa de Benefícios" }]
}
{% endschema %}