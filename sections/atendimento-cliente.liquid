<section class="atendimento">

  <div class="atendimento-container">

    <h2>{{ section.settings.title }}</h2>

    <div class="accordion">

      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="item" {{ block.shopify_attributes }}>
          <span class="item-title">{{ block.settings.title }}</span>
        </a>
      {% endfor %}

    </div>

  </div>

</section>

<style>

.atendimento{
  background:#ffffff;
  padding:80px 20px;
}

.atendimento-container{
  max-width:800px;
  margin:auto;
}

.atendimento h2{
  font-size:32px;
  font-weight:300;
  letter-spacing:1px;
  margin-bottom:40px;
  color:#111;
}

.accordion{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.item{
  display:flex;
  justify-content:flex-start;
  align-items:center;
  padding:20px 24px;
  border:1px solid rgba(0,0,0,0.08);
  border-radius:12px;
  text-decoration:none;
  color:#111;
  background:#fff;
  transition:all 0.3s ease;
  position:relative;
  overflow:hidden;
}

.item::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  height:100%;
  width:3px;
  background:#2b0000;
  transform:scaleY(0);
  transform-origin:top;
  transition:0.3s;
}

.item-title{
  font-size:15px;
  letter-spacing:0.5px;
}

.item:hover{
  background:#2b0000;
  color:#fff;
  transform:translateY(-3px);
  box-shadow:0 15px 40px rgba(0,0,0,0.2);
}

.item:hover::before{
  transform:scaleY(1);
}

@media(max-width:768px){

  .atendimento{
    padding:50px 16px;
  }

  .atendimento h2{
    font-size:22px;
    margin-bottom:24px;
  }

  .accordion{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:4px;
  }

  .item{
    padding:14px 12px;
    border-radius:10px;
  }

  .item-title{
    font-size:13px;
    letter-spacing:0.3px;
  }

}

</style>

{% schema %}
{
  "name": "Atendimento ao Cliente",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Atendimento ao Cliente"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Nome da página"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atendimento ao Cliente"
    }
  ]
}
{% endschema %}