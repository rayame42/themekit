<section class="atendimento">

  <div class="atendimento-container">

    <h2>{{ section.settings.title }}</h2>

    <div class="accordion">

      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="item" {{ block.shopify_attributes }}>
          
          <span class="item-title">
            {{ block.settings.title }}
          </span>

          <span class="arrow">
            →
          </span>

        </a>
      {% endfor %}

    </div>

  </div>

</section>

<style>

/* FUNDO */
.atendimento{
  background:#ffffff;
  padding:80px 20px;
}
/* CONTAINER */
.atendimento-container{
  max-width:800px;
  margin:auto;
}

/* TÍTULO */
.atendimento h2{
  font-size:32px;
  font-weight:300;
  letter-spacing:1px;
  margin-bottom:40px;
  color:#111;
}

/* LISTA */
.accordion{
  display:flex;
  flex-direction:column;
  gap:12px;
}

/* ITEM */
.item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 24px;
  border:1px solid rgba(0,0,0,0.08);
  border-radius:12px;
  text-decoration:none;
  color:#111;
  background:#fff;
  transition:all 0.3s ease;
  position:relative;
  overflow:hidden;
}

/* LINHA LATERAL PREMIUM */
.item::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  height:100%;
  width:3px;
  background:#2b0000;
  transform:scaleY(0);
  transform-origin:top;
  transition:0.3s;
}

/* TEXTO */
.item-title{
  font-size:15px;
  letter-spacing:0.5px;
}

/* SETA */
.arrow{
  font-size:14px;
  opacity:0.5;
  transition:all 0.3s ease;
}

/* HOVER */
.item:hover{
  background:#2b0000;
  color:#fff;
  transform:translateY(-3px);
  box-shadow:0 15px 40px rgba(0,0,0,0.2);
}

.item:hover::before{
  transform:scaleY(1);
}

.item:hover .arrow{
  transform:translateX(6px);
  opacity:1;
}

/* MOBILE */
@media(max-width:768px){

  .atendimento h2{
    font-size:24px;
  }

  .item{
    padding:16px;
  }

}

</style>

{% schema %}
{
  "name": "Atendimento ao Cliente",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Atendimento ao Cliente"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Nome da página"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atendimento ao Cliente",
      "blocks": [
        { "type": "item", "settings": { "title": "Envio e Frete" } },
        { "type": "item", "settings": { "title": "Políticas de Reembolso" } },
        { "type": "item", "settings": { "title": "Fale Conosco" } },
        { "type": "item", "settings": { "title": "Sobre Nós" } }
      ]
    }
  ]
}
{% endschema %}