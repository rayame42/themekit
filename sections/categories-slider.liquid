<section class="cat-slider">

  <div class="container">

    <div class="slider-wrapper">

      <div class="arrow left" onclick="slideCat(-1)">‹</div>
      <div class="arrow right" onclick="slideCat(1)">›</div>

      <div class="slider">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="item">
            <img src="{{ block.settings.img | image_url: width: 800 }}">
            <span>{{ block.settings.title }}</span>
          </a>
        {% endfor %}
      </div>

    </div>

  </div>

</section>

<style>

/* BASE */
.cat-slider{
  padding:40px 0;
}

.container{
  max-width:1200px;
  margin:auto;
}

/* DESKTOP */
.slider{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}

.item img{
  width:100%;
  height:260px;
  object-fit:cover;
  border-radius:12px;
}

.item span{
  display:block;
  text-align:center;
  margin-top:8px;
  font-size:12px;
  letter-spacing:2px;
}

/* MOBILE */
@media(max-width:768px){

  .slider-wrapper{
    position:relative;
  }

  .slider{
    display:flex;
    overflow-x:auto;
    gap:12px;
    padding:0 10px;
    scroll-behavior:smooth;
  }

  .slider a{
    min-width:50%;
    flex:0 0 50%;
  }

  .slider::-webkit-scrollbar{
    display:none;
  }

  /* SETAS */
  .arrow{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:34px;
    height:34px;
    background:#2b0000;
    color:#fff;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:10;
    cursor:pointer;
  }

  .arrow.left{ left:5px; }
  .arrow.right{ right:5px; }

}

</style>

<script>
function slideCat(dir){
  const slider = document.querySelector('.cat-slider .slider');
  const amount = slider.offsetWidth / 2;

  slider.scrollBy({
    left: dir * amount,
    behavior: 'smooth'
  });
}
</script>

{% schema %}
{
  "name": "Categorias Slider",
  "blocks": [
    {
      "type": "cat",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Categorias Slider" }
  ]
}
{% endschema %}