<section class="cat-slider">

  <div class="container">

    <!-- HEADER -->
    <div class="cat-header">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>

    <div class="slider-wrapper">

      <!-- SETAS (ISOLADAS) -->
      <div class="cat-arrow left" onclick="slideCat(-1)">‹</div>
      <div class="cat-arrow right" onclick="slideCat(1)">›</div>

      <div class="slider">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link }}" class="item">
            <img src="{{ block.settings.img | image_url: width: 800 }}">
            <span>{{ block.settings.title }}</span>
          </a>
        {% endfor %}
      </div>

    </div>

  </div>

</section>

<style>

/* BASE */
.cat-slider{
  padding:60px 0;
}

.container{
  max-width:1200px;
  margin:auto;
  padding:0 20px;
}

/* HEADER */
.cat-header{
  text-align:center;
  margin-bottom:35px;
}

.cat-header h2{
  font-size:30px;
  font-weight:300;
}

.cat-header p{
  font-size:14px;
  color:#666;
}

/* DESKTOP */
.slider{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}

/* ITEM FIX (resolve texto atrás) */
.item{
  display:flex;
  flex-direction:column;
  text-decoration:none;
  color:#111;
}

.item img{
  width:100%;
  height:260px;
  object-fit:cover;
  border-radius:14px;
}

.item span{
  margin-top:10px;
  text-align:center;
  font-size:11px;
  letter-spacing:2px;
}

/* MOBILE */
@media(max-width:768px){

  .slider-wrapper{
    position:relative;
  }

  .slider{
    display:flex;
    overflow-x:auto;
    gap:12px;
    padding:0 10px;
    scroll-behavior:smooth;
  }

  .slider a{
    min-width:48%;
    flex:0 0 48%;
  }

  .slider::-webkit-scrollbar{
    display:none;
  }

  /* SETAS CORRETAS */
  .cat-arrow{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:32px;
    height:32px;
    background:#2b0000;
    color:#fff;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:10;
    cursor:pointer;
  }

  .cat-arrow.left{ left:5px; }
  .cat-arrow.right{ right:5px; }

}

/* ESCONDE NO DESKTOP */
@media(min-width:769px){
  .cat-arrow{
    display:none;
  }
}

</style>

<script>
function slideCat(dir){
  const slider = document.querySelector('.cat-slider .slider');
  const amount = slider.offsetWidth * 0.8;

  slider.scrollBy({
    left: dir * amount,
    behavior: 'smooth'
  });
}
</script>

{% schema %}
{
  "name": "Categorias Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Explore por categoria"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Descrição",
      "default": "Peças que despertam desejo, elegância e presença."
    }
  ],
  "blocks": [
    {
      "type": "cat",
      "name": "Categoria",
      "settings": [
        { "type": "image_picker", "id": "img", "label": "Imagem" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Categorias Slider" }
  ]
}
{% endschema %}