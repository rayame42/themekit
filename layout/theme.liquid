<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <style>

/* ===== NEWSLETTER PREMIUM ===== */

.newsletter{
  background:#f5f5f5;
  padding:80px 20px;
}

.newsletter h2{
  font-size:36px;
  font-weight:300;
  letter-spacing:1px;
}

.newsletter input{
  border-radius:40px;
  padding:16px 20px;
  border:1px solid #ccc;
}

.newsletter button{
  border-radius:40px;
  background:#2b0000;
  color:#fff;
  padding:14px 25px;
}


/* ===== FOOTER PREMIUM ===== */

footer{
  background:#2b0000;
  color:#fff;
}

footer a{
  color:#ddd;
  transition:0.3s;
}

footer a:hover{
  color:#fff;
  transform:translateX(3px);
}

</style>
</head>

<body>

{% section 'header' %}

{{ content_for_layout }}

</body>
</html>