<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ shop.name }}</title>

  {{ content_for_header }}

  <style>

  /* RESET */
  body{
    margin:0;
    padding:0;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    background:#fff;
  }

  a{
    text-decoration:none;
  }

  img{
    max-width:100%;
    display:block;
  }

  /* NEWSLETTER */
  .newsletter,
  [class*="newsletter"]{
    background:#fff;
    padding:80px 20px;
    text-align:center;
  }

  .newsletter h2{
    font-size:36px;
    font-weight:300;
    letter-spacing:1px;
    margin-bottom:10px;
  }

  .newsletter p{
    color:#666;
    font-size:14px;
    margin-bottom:30px;
  }

  .newsletter form{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
  }

  input[type="email"]{
    border-radius:40px!important;
    padding:16px 22px!important;
    border:1px solid #ddd!important;
    min-width:260px;
    transition:.3s;
  }

  input[type="email"]:focus{
    outline:none;
    border-color:#2b0000;
  }

  button{
    border-radius:40px!important;
    padding:14px 28px!important;
    background:#2b0000!important;
    color:#fff!important;
    border:none!important;
    cursor:pointer;
    transition:.3s;
  }

  button:hover{
    background:#4a0000!important;
    transform:translateY(-2px);
  }

  /* FOOTER */
  footer,
  [class*="footer"]{
    background:#2b0000!important;
    color:#fff!important;
    padding:70px 40px;
  }

  footer .container,
  [class*="footer"] .container{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:60px;
  }

  footer h3,
  footer h4{
    font-size:13px;
    letter-spacing:2px;
    margin-bottom:18px;
    text-transform:uppercase;
  }

  footer a,
  [class*="footer"] a{
    color:#ccc!important;
    font-size:13px;
    margin-bottom:10px;
    display:block;
    transition:.3s;
  }

  footer a:hover{
    color:#fff!important;
    transform:translateX(4px);
  }

  footer p{
    font-size:13px;
    color:#ddd;
    line-height:1.6;
  }

  /* MOBILE */
  @media(max-width:768px){

    .newsletter{
      padding:60px 20px;
    }

    .newsletter h2{
      font-size:26px;
    }

    input[type="email"]{
      width:100%;
      min-width:100%;
    }

    button{
      width:100%;
    }

    footer{
      padding:50px 20px;
    }

    footer .container,
    [class*="footer"] .container{
      grid-template-columns:1fr;
      gap:30px;
    }

  }

  </style>

</head>

<body>

  {% section 'header' %}

  {{ content_for_layout }}

</body>
</html>