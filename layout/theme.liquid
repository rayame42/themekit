<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ shop.name }}</title>
{{ content_for_header }}

<style>

/* ===== RESET SUAVE ===== */
body{
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* ===== NEWSLETTER PREMIUM ===== */
.newsletter, [class*="newsletter"]{
  background:#fff;
  padding:80px 20px;
  text-align:center;
}

.newsletter h2, h2{
  font-size:36px !important;
  font-weight:300 !important;
  letter-spacing:1px !important;
  margin-bottom:10px;
}

.newsletter p{
  color:#666;
  font-size:14px;
  margin-bottom:30px;
}

.newsletter form{
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
}

input[type="email"]{
  border-radius:40px !important;
  padding:16px 22px !important;
  border:1px solid #ddd !important;
  min-width:260px;
  transition:0.3s;
}

input[type="email"]:focus{
  border-color:#2b0000;
  outline:none;
}

button{
  border-radius:40px !important;
  padding:14px 28px !important;
  background:#2b0000 !important;
  color:#fff !important;
  border:none !important;
  cursor:pointer;
  transition:0.3s;
}

button:hover{
  background:#4a0000 !important;
  transform:translateY(-2px);
}

/* ===== FOOTER PREMIUM ===== */
footer, [class*="footer"]{
  background:#2b0000 !important;
  color:#fff !important;
  padding:70px 40px;
}

footer .container,
[class*="footer"] .container{
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:60px;
}

footer h3, footer h4{
  font-size:13px;
  letter-spacing:2px;
  margin-bottom:18px;
  text-transform:uppercase;
}

footer a, [class*="footer"] a{
  color:#ccc !important;
  text-decoration:none;
  font-size:13px;
  display:block;
  margin-bottom:10px;
  transition:0.3s;
}

footer a:hover{
  color:#fff !important;
  transform:translateX(4px);
}

footer p{
  font-size:13px;
  color:#ddd;
  line-height:1.6;
}

footer strong{
  color:#fff;
}

/* ===== ATENDIMENTO ===== */
summary{
  background:#2b0000 !important;
  color:#fff !important;
  padding:18px !important;
  border-radius:8px;
}

/* remove bug mobile (bolinhas) */
@media(max-width:768px){
  summary::before,
  summary::after{
    display:none !important;
  }
}

/* ===== CATEGORIAS DESKTOP ===== */
.categories{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  padding:30px 40px;
}

/* ===== SLIDER MOBILE COM SETAS (CORRIGIDO) ===== */
@media(max-width:768px){

  .categories-wrapper{
    position:relative;
  }

  .categories{
    display:flex !important;
    flex-wrap:nowrap !important;
    overflow-x:auto !important;
    scroll-behavior:smooth;
    gap:12px;
    padding:20px;
  }

  .categories a{
    min-width:50% !important;
    flex:0 0 50% !important;
  }

  .categories::-webkit-scrollbar{
    display:none;
  }

  .arrow{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    width:36px;
    height:36px;
    background:#2b0000;
    color:#fff;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    z-index:5;
  }

  .arrow.left{ left:5px; }
  .arrow.right{ right:5px; }

}

</style>
</head>

<body>

{% section 'header' %}

{{ content_for_layout }}

