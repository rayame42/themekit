<!doctype html>
<html>
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-18239493909"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-18239493909');
</script>

  <title>
    {{ page_title }}
    {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
  {% if request.page_type == 'product' %}
    <meta property="og:type" content="product">
    <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
    <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {% else %}
    <meta property="og:type" content="website">
  {% endif %}
  {% if page_image %}
    <meta property="og:image" content="https:{{ page_image | image_url }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {% endif %}

  <script>jdgm = window.jdgm || {};jdgm.SHOP_DOMAIN = 'mpqbsz-ij.myshopify.com';jdgm.PLATFORM = 'shopify';jdgm.PUBLIC_TOKEN = 'ab0uT91c-f3c5ChTDtkb2h4colc';</script>
  <script data-cfasync='false' type='text/javascript' src='https://cdnwidget.judge.me/widget_preloader.js'></script>

  {{ content_for_header }}

  <style>

  /* RESET */
  body{
    margin:0;
    padding:0;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    background:#fff;
  }

  a{
    text-decoration:none;
  }

  img{
    max-width:100%;
    display:block;
  }

  /* JUDGE.ME */
  .jdgm-revs-tab-btn{
    background-color:#8B1E3F !important;
  }

  .jdgm-star{
    color:#8B1E3F !important;
  }

  /* NEWSLETTER */
  .newsletter,
  [class*="newsletter"]{
    background:#fff;
    padding:80px 20px;
    text-align:center;
  }

  .newsletter h2{
    font-size:36px;
    font-weight:300;
    letter-spacing:1px;
    margin-bottom:10px;
  }

  .newsletter p{
    color:#666;
    font-size:14px;
    margin-bottom:30px;
  }

  .newsletter form{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
  }

  input[type="email"]{
    border-radius:40px!important;
    padding:16px 22px!important;
    border:1px solid #ddd!important;
    min-width:260px;
    transition:.3s;
  }

  input[type="email"]:focus{
    outline:none;
    border-color:#2b0000;
  }

  button{
    border-radius:40px!important;
    padding:14px 28px!important;
    background:#2b0000!important;
    color:#fff!important;
    border:none!important;
    cursor:pointer;
    transition:.3s;
  }

  button:hover{
    background:#4a0000!important;
    transform:translateY(-2px);
  }

  /* FOOTER */
  footer,
  [class*="footer"]{
    background:#2b0000!important;
    color:#fff!important;
    padding:70px 40px;
  }

  footer .container,
  [class*="footer"] .container{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:60px;
  }

  footer h3,
  footer h4{
    font-size:13px;
    letter-spacing:2px;
    margin-bottom:18px;
    text-transform:uppercase;
  }

  footer a,
  [class*="footer"] a{
    color:#ccc!important;
    font-size:13px;
    margin-bottom:10px;
    display:block;
    transition:.3s;
  }

  footer a:hover{
    color:#fff!important;
    transform:translateX(4px);
  }

  footer p{
    font-size:13px;
    color:#ddd;
    line-height:1.6;
  }

  /* CATEGORIAS */
  .categories{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    padding:30px 40px;
  }

  /* MOBILE */
  @media(max-width:768px){

    .newsletter{
      padding:60px 20px;
    }

    .newsletter h2{
      font-size:26px;
    }

    input[type="email"]{
      width:100%;
      min-width:100%;
    }

    button{
      width:100%;
    }

    footer{
      padding:50px 20px;
    }

    footer .container,
    [class*="footer"] .container{
      grid-template-columns:1fr;
      gap:30px;
    }

    .categories-wrapper{
      position:relative;
    }

    .categories{
      display:flex!important;
      flex-wrap:nowrap!important;
      overflow-x:auto!important;
      scroll-behavior:smooth;
      gap:12px;
      padding:20px;
    }

    .categories a{
      min-width:50%!important;
      flex:0 0 50%!important;
    }

    .categories::-webkit-scrollbar{
      display:none;
    }

    .arrow{
      position:absolute;
      top:50%;
      transform:translateY(-50%);
      width:36px;
      height:36px;
      background:#2b0000;
      color:#fff;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      z-index:5;
    }

    .arrow.left{ left:5px; }
    .arrow.right{ right:5px; }

  }

  </style>

</head>

<body>

  {% section 'header' %}

  {{ content_for_layout }}

  <script>
  function slideCategories(direction){
    const container = document.querySelector('.categories');
    if(!container) return;
    const scrollAmount = container.offsetWidth / 2;
    container.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
  }

  document.addEventListener('DOMContentLoaded', function(){
    var check = setInterval(function(){
      if(window.jdgm){
        if(window.jdgm.customWidgets && window.jdgm.customWidgets.load){
          window.jdgm.customWidgets.load();
        }
        if(window.jdgm.Widget && window.jdgm.Widget.load){
          window.jdgm.Widget.load();
        }
        if(window.jdgm.init){
          window.jdgm.init();
        }
        clearInterval(check);
      }
    }, 200);
  });
  </script>

</body>
</html>